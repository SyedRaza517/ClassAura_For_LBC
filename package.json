{
  "name": "staff-hub",
  "version": "1.0.0",
  "description": "Staff Hub — college management platform, one deployment per institution (server + client)",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "studio": "npm --workspace server run studio",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
