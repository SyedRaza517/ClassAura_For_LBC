# Copy this file to .env and adjust as needed.

# ---------------------------------------------------------------------------
# Database. PostgreSQL only — schema.prisma declares provider = "postgresql",
# so the old "file:./dev.db" SQLite URL this file used to ship could never work
# against it. There is no local database file any more.
#
# The value below is a LOCAL Postgres. Point it at a database you own and can
# afford to lose: `npm run setup` and `npm run seed` DELETE staff, students,
# check-ins, leave and documents before writing their fixtures.
#
# prisma/assertDisposable.js refuses to seed a remote database unless its name
# marks it disposable (…_staging, …_test) or you confirm it explicitly. That is a
# backstop, not permission to point this at something live.
# ---------------------------------------------------------------------------
# On Supabase, use the SESSION pooler URL (port 5432). The transaction pooler (port
# 6543) breaks Prisma's prepared statements and hangs `prisma migrate deploy`;
# `npm run migrate:deploy` refuses it before starting, with the fix in the message.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edtech_dev"

# NODE_ENV IS WHAT MAKES THE LINE BELOW TRUE, so it is documented here rather than left
# to the host to supply. auth.js refuses to start without a JWT_SECRET only when
# NODE_ENV === "production"; with it unset, a missing secret falls back to the literal
# "dev-only-change-me" — which is in this repository, so anyone holding a copy could
# forge an admin token. render.yaml sets it, but a service created outside the blueprint,
# or one where the variable is later deleted in the dashboard, silently loses the check
# that the next line promises.
NODE_ENV="development"

# Must be a long random string. In production the server REFUSES to start without
# one rather than falling back to a known default.
JWT_SECRET="change-this-to-a-long-random-string"
# How long a session lasts: "8h", "1d", "7d".
JWT_EXPIRES="1d"
PORT=4000

# ---------------------------------------------------------------------------
# This deployment's institution.
#
# ONE DEPLOYMENT SERVES ONE COLLEGE, with its own database. There is no X-Tenant
# header, no subdomain resolution and no "which college is this request for?"
# question — every request is about this institution, and the old
# DEFAULT_TENANT_SLUG, TENANT_BASE_DOMAIN and TENANT_CACHE_MS variables are gone.
# If they are still set on a deployed service, nothing reads them; see render.yaml
# for the ones that need removing by hand in the Render dashboard.
# ---------------------------------------------------------------------------
# The slug of the single institution row the seed creates or updates. It NAMES
# this deployment's institution; it does not select between several, because
# there are no others. It applies only when the institution row is first created:
# the seed upserts on a constant primary key, so once the row exists, changing
# this does nothing at all. Rename the institution on the Settings screen.
# SEED_TENANT_SLUG="default"
# 32-byte key (64 hex chars) encrypting this institution's stored Moodle and
# SharePoint credentials at rest — AES-256-GCM, see src/secrets.js. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, integration credentials cannot be saved or read.
# CREDENTIALS_KEY=""

# The organisation's wall clock. Drives "today", the term gate and the 02:00
# Moodle sync — not the host's timezone, which on a cloud host is usually UTC.
APP_TIMEZONE="Europe/London"
# Where the client is served. Password-reset links are built from this, so it must
# match the address people actually use, not localhost, once you deploy.
CLIENT_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Email (optional). Leave every SMTP_* line commented out and the app prints
# messages to the console instead of sending them — handy for local development,
# but password-reset links will never reach real staff.
#
# Test your settings with:  node scripts/check-email.mjs you@example.com
# ---------------------------------------------------------------------------

# Either a single connection string...
# SMTP_URL="smtp://user:password@smtp.example.com:587"

# ...or the individual settings:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587           # 587 = STARTTLS (usual), 465 = implicit TLS
# SMTP_SECURE=false       # set true only for port 465
# SMTP_USER="no-reply@edtech.co.uk"
# SMTP_PASS="app-password-here"

# The From: address staff will see.
# MAIL_FROM="EdTech Staff Hub <no-reply@edtech.co.uk>"

# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an
#   App Password (Google Account -> Security -> 2-Step Verification -> App
#   passwords). Your normal password will NOT work.
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.

# ---------------------------------------------------------------------------
# Push notifications (optional). Unset = notifications are logged to the console;
# the in-app bell and email still work. Needed for the mobile app.
#
# Set up: Firebase console -> Project settings -> Service accounts ->
#         Generate new private key. Keep that JSON OUT of the repository.
# Test with:  node scripts/check-push.mjs
# ---------------------------------------------------------------------------
# FCM_PROJECT_ID="edtech-hub"
# FCM_SERVICE_ACCOUNT="C:/secure/path/firebase-service-account.json"
# ...or paste the JSON inline instead (for hosts that only offer env vars):
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'

# ---------------------------------------------------------------------------
# Document storage (Supabase Storage) — the FALLBACK when SharePoint is not
# configured, and the store for staff documents either way.
#
# UNDOCUMENTED UNTIL NOW, WHICH COST A WHOLE FEATURE. storage.js reads these three
# and nothing else mentions them — not this file, not render.yaml. A service
# created from the blueprint therefore gets `undefined`, isConfigured() returns
# false, and EVERY DOCUMENT UPLOAD FAILS: staff documents, applicant passports and
# ID scans, the lot. The only signal is one line at boot saying storage is not
# configured, which nobody is watching at the moment an upload is refused.
#
# THE BUCKET MUST BE PRIVATE. These files include payroll and HR documents tied to
# a named person, plus applicants' identity documents. Reads go through short-lived
# signed URLs minted only after the API has checked the caller may see that file; a
# public bucket makes all of it readable by anyone who can guess a URL.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. Server-side only — it must
# never be given to a client, and never prefixed VITE_.
# ---------------------------------------------------------------------------
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="the service_role key from Project Settings -> API"
# SUPABASE_BUCKET="documents"

# ---------------------------------------------------------------------------
# Integration credentials (Moodle, Canvas, Blackboard, SharePoint, SMTP/Resend).
#
# PREFER THE SETTINGS SCREEN. These are stored per-institution in the database,
# encrypted at rest, and an administrator maintains them there — a value only
# changeable by a deploy is not a setting. The environment is the FALLBACK, read
# only when the college has saved nothing, and it describes this deployment's own
# institution. See integrationConfig.js for the precedence.
#
# Listed here because roughly thirty such names are read by the code and were
# admitted to by no configuration file, which makes an unset integration look like
# a bug rather than a choice. Uncomment only what this deployment actually needs.
# ---------------------------------------------------------------------------
# MOODLE_URL=""            # MOODLE_TOKEN, MOODLE_AUTO_SYNC
# CANVAS_URL=""            # CANVAS_TOKEN, CANVAS_AUTO_SYNC
# BB_URL=""                # BB_APP_ID, BB_APP_KEY, BB_APP_SECRET, BB_AUTO_SYNC
# SP_SITE_URL=""           # SP_TENANT_ID, SP_CLIENT_ID, SP_CLIENT_SECRET,
#                          # SP_SITE_HOST, SP_SITE_PATH, SP_SITE_ID,
#                          # SP_DRIVE_ID, SP_DRIVE_NAME, SP_ROOT_FOLDER
#                          # (SP_TENANT_ID is MICROSOFT's directory id, not ours)
# RESEND_API_KEY=""        # set in render.yaml; unset means reset links print to the log
# CORS_ORIGINS=""          # comma-separated; falls back to CLIENT_URL, then localhost:5173

# ---------------------------------------------------------------------------
# Keep-alive (free Render instances sleep). KEEPALIVE_URL="off" disables it.
# ---------------------------------------------------------------------------
# KEEPALIVE_URL=""         # defaults to RENDER_EXTERNAL_URL, which Render injects
# KEEPALIVE_MINUTES="10"
