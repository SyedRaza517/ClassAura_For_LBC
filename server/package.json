{
  "name": "edtech-hub-server",
  "version": "1.0.0",
  "description": "EdTech Staff Hub — API server",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --watch-path=./src src/index.js",
    "start": "node src/index.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "node prisma/check-database-url.js && prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "studio": "prisma studio",
    "setup": "prisma generate && prisma migrate deploy && node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "prisma": "^5.22.0"
  }
}
