# Copy this file to `keystore.properties` (same folder) and fill in the real values.
#
# `keystore.properties` is gitignored — it holds the upload key's passwords and must
# never be committed. Without it the release build still runs, but produces an
# UNSIGNED bundle that Google Play refuses on upload.
#
# storeFile: use forward slashes, even on Windows.
storeFile=C:/Users/Lenovo/Desktop/keys/edtech-upload.jks
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password
