<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nothing in this file names an institution, and it must stay that way: the
         label, the icon and the FileProvider authority are all references
         (@string/app_name, @mipmap/ic_launcher, ${applicationId}) that resolve from
         client/brand.properties via app/build.gradle. A white-label build therefore
         never edits the manifest. -->

    <!-- Backup is off deliberately. The only local state is the session JWT in
         WebView localStorage; with backup on, a live staff session is copied to
         Google's servers and restored onto any new device set up from that backup —
         already signed in, and with the biometric app-lock flag restored too.
         There is nothing here worth backing up. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Status-bar icon and colour for push notifications. Without these,
             Android renders every notification as an anonymous white blob. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 (API 33) and later require this to be DECLARED before the
         runtime prompt can even be shown. Without it requestPermissions() is
         auto-denied with no dialog, so push could never be enabled on a modern
         phone. targetSdk here is 36, so this is not optional. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Used by the biometric app lock (Face/fingerprint unlock). Harmless on
         devices without a sensor — the feature simply reports itself unavailable. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Reading the attendance stickers. Not a runtime permission: Android grants NFC
         at install time, so there is no prompt to handle. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- The in-app scanner for the check-in code (QrScanner.jsx). Not required: a phone
         with no camera still signs in and uses the lecturer's register as usual. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- android:required="false" IS LOAD-BEARING AND MUST NOT BE REMOVED.
         Declaring the NFC permission above makes Google Play infer a hardware
         requirement, and the default for that inference is REQUIRED — which would
         hide this app from the Play Store listing of every phone without an NFC chip.
         Those students still need the app: attendance figures, results, timetable and
         messaging have nothing to do with tapping, and their lecturer marks them in
         the usual way. Stating required="false" explicitly overrides the inference and
         keeps the app installable on every handset.
         The code already copes: nfc.js reports "no-hardware" and the check-in card
         renders an explanation instead of a dead button. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
</manifest>
