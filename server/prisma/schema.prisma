// EdTech — Staff Hub database schema
//
// PostgreSQL. The old "SQLite locally, change one line for production" arrangement is
// gone: the two disagree on typing and case-sensitivity in ways that hid real bugs
// (an out-of-range integer SQLite stored happily and Postgres refuses; unquoted
// identifiers that SQLite folds and Postgres does not).
//
// This schema was multi-tenant. Every model except Tenant and PlatformAdmin carried
// a tenantId, and src/db.js rewrote every query to filter and stamp it. One
// deployment now serves one institution with its own database, so isolation is a
// property of the infrastructure and the column is gone from all 61 of them. The
// history is worth knowing because it explains shapes that would otherwise look
// arbitrary — see the header of src/db.js, which records what was removed and what
// would have to come back first.

generator client {
  provider = "prisma-client-js"
  // Pinned, and it has to be.
  //
  // npm workspaces installs @prisma/client TWICE — once hoisted to the repo root and
  // once under server/ — and `prisma generate` resolves one of them while the running
  // server resolves the other. On a fresh install that meant the real client was
  // generated into the root copy while server/src loaded the stub next to server's
  // copy, which throws "@prisma/client did not initialize yet". It survived locally
  // only because an older node_modules happened to be in the right state; CI, which
  // always installs fresh, failed on the seed with migrations having already applied
  // cleanly — the confusing shape of the bug.
  //
  // This path is relative to THIS file, so it always lands in server/node_modules,
  // which is where server/src resolves @prisma/client from. Generation and runtime
  // can no longer disagree.
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One institution's credentials for one external system (Moodle, SharePoint).
///
/// These were process-level env vars, which cannot work once more than one college
/// exists: every tenant would sync from, and upload into, the same institution's
/// systems. The secret half is encrypted at rest and never returned to any client —
/// the API reports only whether it is configured and when it was last changed.
model TenantIntegration {
  id           String    @id @default(cuid())
  /// "moodle" | "sharepoint"
  provider     String
  /// AES-256-GCM ciphertext. Never serialised to a response.
  secretEnc    String
  /// Non-secret settings shown back in the UI, as JSON — a Moodle URL, a SharePoint
  /// site path. Nothing here is sensitive; anything sensitive belongs in secretEnc.
  settings     String?
  /// Whether this integration is switched on for this institution.
  enabled      Boolean   @default(false)
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  lastTestNote String?
  updatedAt    DateTime  @updatedAt
  updatedBy    String?

  @@unique([provider])
}

/// An append-only record of who did what.
///
/// The readiness plan asks for "material record changes and privileged actions
/// logged", and it is the item a college's IT team asks about by name — because it
/// is what lets them answer "who changed this student's grade" six months later.
///
/// Every row here belongs to this institution, because every row in this database
/// does. It was once scoped by tenant like everything else, and platform-operator
/// actions were recorded against the institution they AFFECTED so a college could see
/// that the supplier
/// suspended them — that transparency is the point, not an oversight.
///
/// There is no update and no delete endpoint anywhere. A log that can be edited by
/// the people it records is not evidence.
model AuditLog {
  id String   @id @default(cuid())
  at DateTime @default(now())

  /// staff | student | applicant | platform | system | anonymous — which tier acted.
  /// A platform operator is not a Staff row, and a Student id is drawn from a different
  /// table, so actorId alone would be ambiguous. "anonymous" is a failed sign-in or a
  /// reset asked for on an address that may not have an account: there is no id, but
  /// the attempt still has to be counted.
  actorType  String
  actorId    String?
  /// Denormalised on purpose: an account can be deleted, and the log still has to
  /// say who did it.
  actorEmail String?

  /// Verb, dotted and stable: "staff.access.changed", "leave.decided",
  /// "tenant.suspended". Queried and filtered on, so it must not be prose.
  action   String
  /// What was acted on — model name and id, for filtering to one record's history.
  entity   String?
  entityId String?

  /// One line a person can read without decoding the diff.
  summary String

  /// What actually changed. Secrets are never written here — see audit.js.
  before Json?
  after  Json?

  ip        String?
  userAgent String?

  @@index([at])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
}

/// Everything about how one institution PRESENTS itself — its name in a letter, the
/// colours of its app, its logo, the address at the foot of an offer.
///
/// All of this used to be literals scattered across the code: "EdTech" in sixteen
/// server files, "42 The Burroughs, Hendon" in the offer letter, #1a3a8f in
/// seventy-six places in the client. A second college would have sent its applicants
/// letters branded for the first one — which is not a cosmetic problem, it is a
/// letter from the wrong institution.
///
/// One row, every column optional. It was one row per tenant, and the constant
/// primary key is what now guarantees "one" — see the id field. Missing values fall
/// back to the
/// platform defaults, so an institution that sets nothing looks exactly as it did
/// before this existed and a college can change one thing without supplying all of it.
model TenantBranding {
  id String @id @default("singleton")

  // --- names ---
  /// The college's full legal name, e.g. "Riverside College of Further Education" —
  /// used in letters, emails and page titles. Deliberately an invented example: this
  /// table exists so no institution's name is written into the product, and an example
  /// naming a real college is how one ends up read as the default.
  displayName String?
  /// The short form, e.g. "Riverside" — where the full name will not fit.
  shortName   String?
  /// The two lines of the app's own lockup, e.g. "EDTECH" / "HUB".
  wordmarkTop String?
  wordmarkSub String?

  // --- colour ---
  /// Hex, validated server-side. primary drives headers and links; accent is the second
  /// colour in gradients and highlights.
  primaryColor String?
  accentColor  String?

  /// Buttons, set separately from primary ON PURPOSE.
  ///
  /// A colour that reads well as a wide header band is often wrong as a small solid
  /// button — a pale brand colour gives a button nobody can see, and a very dark one
  /// swallows its own label. Deriving the button from primary therefore produced
  /// unreadable controls for perfectly reasonable palettes. A college can now set the
  /// button fill and the text on it directly, and both fall back to primary and to a
  /// luminance-chosen black or white when they are not set.
  buttonColor     String?
  buttonTextColor String?

  // --- logo ---
  /// A data: URI. Deliberately NOT a file in object storage: branding is small, is
  /// read on every page load, and must not add a storage dependency to a college
  /// simply picking its colours. Capped server-side — see routes/branding.js.
  logoDataUri String?
  /// Content type of the above, for the size/type check on save.
  logoType    String?

  // --- correspondence: what appears in letters and at the foot of a PDF ---
  addressLines   String?
  contactEmail   String?
  contactPhone   String?
  website        String?
  /// "a company limited by guarantee registered in England and Wales 6683232"
  legalFooter    String?
  signatoryName  String?
  signatoryTitle String?
  /// The addresses outbound mail is sent from, as JSON: {attendance, pat, ask, wellbeing}.
  /// Each falls back to the process-wide MAIL_FROM_* and then to the platform default.
  mailFrom       String?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// A college's OWN document template — the PDF it already sends, with the places
/// marked where an applicant's details belong.
///
/// The generated offer letter used to be drawn from scratch by pdfkit, which meant
/// every institution's letter looked like the one college the code was written for.
/// A college cannot be asked to abandon its letterhead, its typography and its
/// registered-office footer because of how the software draws.
///
/// So their PDF is not redrawn — it is used AS the page, and the dynamic values are
/// written on top at coordinates they positioned themselves. That is the only way the
/// result is their template exactly rather than an approximation of it: nothing is
/// re-typeset, so nothing can drift.
model TenantDocTemplate {
  id String @id @default(cuid())

  /// "offer" | "application" — which generated document this replaces.
  kind String

  /// The uploaded PDF itself. Bytes, not a storage URL: a college uploading a
  /// letterhead should not first have to have object storage configured, and this is
  /// read only when a letter is generated rather than on every page load.
  pdf      Bytes
  pdfName  String?
  pdfPages Int?

  /// Where each value goes, as JSON:
  ///   [{ key, page, xPct, yPct, size, bold, align, colour }]
  /// Positions are stored as a PERCENTAGE of page width/height, not points, so a
  /// template re-exported at a different page size still places its fields correctly.
  fields String?

  /// Off until positioned, so uploading a PDF cannot silently start sending letters
  /// with no applicant name on them.
  enabled Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([kind])
}

/// A college's own wording for one of the emails the system sends.
///
/// Subject and body are stored with {{placeholders}}; the sender, logo and colours
/// come from TenantBranding, so a college changes what an email SAYS without having
/// to rebuild what it looks like.
model TenantEmailTemplate {
  id String @id @default(cuid())

  /// Which email: "offer" | "interview" | "pat" | "attendance" | "admission" ...
  kind    String
  subject String?
  body    String?
  enabled Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([kind])
}

/// THIS INSTITUTION. One row.
///
/// It was the registry OF institutions, and the one table src/db.js never scoped,
/// because scoping the list of tenants by tenant is circular. One deployment now
/// serves one college, so it holds that college — its name, and little else. The
/// only thing that still reads it is branding.js, as the display name to fall back
/// on when the college has not set one.
///
/// Kept rather than dropped because the alternative was moving what remains into env
/// vars or a new singleton table, which is what this already is.
model Tenant {
  /// A CONSTANT PRIMARY KEY, for the reason the five config singletons have one.
  ///
  /// Everything above rests on "this table holds THE institution", and nothing
  /// enforced that: the id was a cuid, so a second row was insertable, and the only
  /// reader is an unordered findFirst() — which would then return one of two
  /// institutions at the planner's discretion, and the college's name in its own
  /// letters would change between requests. The table every config singleton is
  /// modelled on was the one without the guarantee.
  ///
  /// A second insert now collides instead. That is a loud failure in the one place a
  /// silent one would be worst.
  id        String   @id @default("singleton")
  /// Named the subdomain the customer was reached on ("brookes" ->
  /// brookes.edtech.co.uk) back when one server answered for several colleges.
  /// Nothing resolves a subdomain any more; this is now just a stable short name,
  /// and SEED_TENANT_SLUG in prisma/seed.js is what sets it.
  slug      String   @unique
  name      String
  /// Meant an ended contract, switched off rather than deleted so the data stayed
  /// recoverable until the retention schedule removed it. A deployment cannot
  /// suspend itself, so nothing reads this now; it is left in place because dropping
  /// a column earns nothing and the word may be wanted again.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

model Staff {
  id           String  @id @default(cuid())
  name         String
  jobTitle     String
  dept         String
  email        String
  dob          String? // YYYY-MM-DD — used for birthday emails (optional)
  passwordHash String
  accountRole  String  @default("STAFF") // ADMIN | STAFF
  // The staff member's home site — chosen at sign-up. HND | FE | Online. Nullable
  // because accounts that predate this field (and admin-created ones) may not have
  // set one; the Staff-tab site filter treats those as "unset".
  site         String?

  // --- Admin access control (RBAC) ---
  // The Super Admin assigns which admin-dashboard pages each admin may see/use, and
  // is the only account allowed to open the Access tab. Exactly one account should
  // carry this (bootstrapped onto the oldest admin).
  isSuperAdmin       Boolean @default(false)
  // Which admin pages this admin may access, as a JSON array of tab keys, e.g.
  // '["staff","requests"]'. NULL means "never configured" → full access (so existing
  // admins are not locked out). '[]' means configured with NO pages. Ignored for a
  // Super Admin, who always has everything.
  adminPages         String?
  /// Which SUPPORT DEPARTMENTS this person belongs to, as a JSON array of department
  /// keys, e.g. '["wellbeing"]'. Null means none.
  ///
  /// A STRING ARRAY RATHER THAN A GRANTABLE PAGE, and that is forced rather than
  /// chosen. The department list is configuration the college edits at runtime, so a
  /// college adding "Careers" at four in the afternoon cannot also add a permission
  /// key to the four hand-maintained copies of ADMIN_PAGES. The page "referrals"
  /// grants the FEATURE; this column decides which queues within it a person sees.
  ///
  /// Deliberately NOT ignored for a Super Admin, unlike adminPages above. Holding
  /// every admin page is a statement about administrative authority; being on the
  /// wellbeing team is a statement about who reads a student's disclosures, and
  /// "the most senior account sees every case note by default" is exactly the
  /// outcome the confidentiality split exists to prevent.
  supportDepartments String?
  allowance          Int     @default(28)
  initials           String
  colour             String
  // When true, the user must set a new password before using the app
  // (set for admin-created accounts that start on a temporary password).
  mustChangePassword Boolean @default(false)

  // --- Two-factor authentication (TOTP / authenticator app) ---
  // totpSecret is the base32 shared secret. It is NEVER returned by the API once
  // enrolment is complete — it is only shown during the setup step.
  totpSecret    String?
  // True once the user has proved they can generate a valid code. Login then
  // requires a second step. Seeded/admin accounts leave this false, so the
  // existing one-step dashboard login is unchanged.
  totpEnabled   Boolean @default(false)
  // True for accounts created by approving a sign-up request: 2FA is MANDATORY.
  // They must enrol an authenticator on first sign-in before reaching the app,
  // and (unlike a voluntary enroller) they cannot switch it off afterwards.
  // Stays true once enrolled — totpEnabled is what tracks enrolment state.
  mustSetupTotp Boolean @default(false)

  // Bumped whenever every existing session must be invalidated — a password
  // reset, or a password change. Signed into each JWT and compared on every
  // request, which gives us revocation without a server-side session store.
  tokenVersion Int @default(0)

  // True between "an admin added this person" and "that person set their own
  // password from the invitation email". Such an account CANNOT be signed into.
  // Previously admin-created accounts were given the shared default password, so
  // anyone who guessed the email address could sign straight in as them.
  pendingActivation Boolean @default(false)

  /// Lifts the departmental boundary entirely — Principal, Registrar, Super Admin.
  ///
  /// DELIBERATELY A SEPARATE FLAG FROM isSuperAdmin. Holding every admin page is a
  /// statement about administrative authority; seeing every department's students,
  /// registers and pastoral records is a statement about academic reach, and at many
  /// colleges those are not the same person. This is the same reasoning that keeps
  /// supportDepartments un-ignored for a Super Admin.
  ///
  /// DEFAULTS TO TRUE, and narrowing is the deliberate act.
  ///
  /// This is the same shape as `adminPages` above, where NULL means "never configured →
  /// full access (so existing admins are not locked out)". The first migration set the
  /// flag on every account that existed WHEN IT RAN, which says nothing about accounts
  /// created afterwards — and a college that has not yet configured any departments would
  /// hand a newly created tutor no students, no courses and no registers, with no screen
  /// explaining why.
  ///
  /// Fail-open here is therefore the safe direction, and it is not silent: the
  /// Departments screen carries a permanent "N of M staff have college-wide access" line,
  /// which is the college's to-do list for narrowing people deliberately.
  collegeWide Boolean @default(true)

  createdAt DateTime @default(now())

  /// Which academic departments this person may see. See StaffAcademicDepartment for
  /// why this is a join table rather than a JSON array like supportDepartments above.
  academicDepartments StaffAcademicDepartment[]

  checkIns         CheckIn[]
  leaves           Leave[]
  adjustments      Adjustment[]
  documents        Document[]            @relation("AssignedDocs")
  notifications    Notification[]        @relation("StaffNotifications")
  passwordResets   PasswordReset[]
  devices          DeviceToken[]
  timesheetEntries TimesheetEntry[]
  staffReviews     StaffReview[]
  studentReviews   StudentReview[]
  unitsTaught      Unit[]                @relation("UnitTutor")
  unitsLed         Unit[]                @relation("UnitLeader")
  announcements    Announcement[]        @relation("AnnouncementSender")
  conductLogged    ConductEvent[]        @relation("ConductLogger")
  // Timetabled events this person teaches, and their own display settings.
  timetableEvents  TimetableEventStaff[]
  timetablePref    TimetableUserPref[]

  // The Microsoft (Entra) user this staff member was matched to by Teams provisioning
  // (added to a cohort's Team, a unit's channel), so later runs re-use the match instead
  // of re-resolving by email every time. Same job, same reasoning, as Student.msUserId.
  msUserId String?

  @@unique([email])
  @@unique([msUserId])
}

// A phone (or browser) registered to receive push notifications.
//
// The token is issued by Firebase Cloud Messaging and identifies one install of
// the app on one device. It is unique because the same handset must not end up
// registered to two people — when someone else signs in on a shared phone the row
// is reassigned rather than duplicated, so the previous user stops receiving
// notifications for an account they no longer hold.
// staffId was NOT NULL and the only owner until the student app needed to register its
// own devices for push. Widened the same way, and for the same reason, as Notification
// above: nullable staffId alongside an equally nullable studentId, with EXACTLY ONE of
// the two ever set. Enforced by a raw-SQL CHECK the migration adds
// (DeviceToken_one_owner_check) — Prisma cannot see it here either; see Notification's
// comment and the HndSession partial-index precedent it points at.
model DeviceToken {
  id         String   @id @default(cuid())
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId    String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String?
  /// Unique — see @@unique([token]) below.
  ///
  /// It was unique per INSTITUTION while one database served several, because an FCM
  /// registration token identifies a DEVICE: somebody employed at two colleges — the
  /// case tenancy existed to support — registered the handset at the first, collided
  /// at the second, and could not receive push there at all. One college per
  /// deployment means one row per device again.
  token      String
  platform   String   @default("unknown") // ios | android | web
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([token])
  @@index([staffId])
  @@index([studentId])
}

// A single-use "forgot password" token.
//
// Only the SHA-256 HASH of the token is stored: the raw value exists solely in
// the emailed link. Anyone who reads this table therefore cannot reset anything,
// the same reasoning that applies to storing password hashes rather than passwords.
model PasswordReset {
  id        String    @id @default(cuid())
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  tokenHash String    @unique
  // "reset"  — forgotten password, 30 minutes
  // "invite" — first-time activation of an admin-created account, 7 days, because
  //            the person may not read their email the same day
  purpose   String    @default("reset")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
}

// A self-service sign-up from the staff mobile app, awaiting admin approval.
//
// Applicants deliberately live here rather than in Staff: an unapproved person
// must not appear in calendars, registers or the staff list, and must not be able
// to sign in. On approval the row is copied into Staff (password hash included,
// so the applicant keeps the password they chose) and marked approved.
model SignupRequest {
  id           String   @id @default(cuid())
  // "staff" (the default — creates a Staff account on approval) or "student" (links
  // to / creates a Student account). Student requests only carry name/email/password;
  // the jobTitle/dept/site fields are left blank for them.
  kind         String   @default("staff")
  // For a student request: the existing Student row it matched, if any (by college
  // ID first, then email). Null means no match — the admin decides on approval.
  studentId    String?
  // The student's college ID (their student number). Used to match/verify the
  // existing student record; blank for staff requests.
  collegeId    String?
  name         String
  email        String
  passwordHash String
  jobTitle     String // "position" on the sign-up form
  dept         String
  site         String? // HND | FE | Online — home site chosen on the sign-up form
  status       String   @default("pending") // pending | approved | rejected
  note         String? // admin's reason, shown to nobody yet but kept for audit
  decidedBy    String?
  decidedAt    String?
  createdAt    DateTime @default(now())

  /// Which school (AcademicDepartment) this applicant will be filed under when approved.
  ///
  /// NULLABLE, AND NULL IS THE ONLY HONEST DEFAULT FOR AN EXISTING ROW. Every request
  /// already in the queue when this column shipped was made without anyone being asked
  /// the question, and backfilling a school onto them would be inventing an answer —
  /// the same silent fail-open academicDepartments.js refuses to ship a "General"
  /// department for. It stays null until an administrator says otherwise, and approval
  /// works exactly as before when it does.
  ///
  /// A SUGGESTION, NOT A GRANT. Nothing reads this column for access control. It is
  /// carried on the request so an administrator triaging the queue can record the answer
  /// before deciding; the grant itself is the StaffAcademicDepartment row that approval
  /// writes, which is the same row routes/academicDepartments.js writes and the only
  /// place membership lives.
  ///
  /// A REAL FOREIGN KEY WITH SetNull, matching every other academicDepartmentId in this
  /// schema, rather than the bare string it could have been. Deleting a school then
  /// clears the suggestion instead of leaving a dangling id that approval would have to
  /// decide what to do about — and "the school was deleted, so approve without one" is
  /// exactly what SetNull already means. Deliberately NOT counted by DELETE
  /// /api/timetabling/departments/:id when it decides retire-versus-delete: a pending
  /// request losing its suggested school costs an administrator one dropdown, where a
  /// course or a student losing theirs hides people from their own tutors.
  academicDepartment   AcademicDepartment? @relation(fields: [academicDepartmentId], references: [id], onDelete: SetNull)
  academicDepartmentId String?

  @@unique([email])
  @@index([status])
  @@index([academicDepartmentId])
}

// A persisted, per-user notification (survives reload, unlike the in-memory toasts).
//
// staffId was NOT NULL and the only owner until the student app needed its own
// persisted feed (a check-in confirmed, a query answered, a streak milestone). Widened
// to nullable and given an equally nullable studentId, with EXACTLY ONE of the two ever
// set — a row owned by nobody is unreadable by anyone, and a row owned by both would
// leak between the staff and student audiences, which must never read each other's
// notifications. That invariant is a raw-SQL CHECK the migration adds
// (Notification_one_owner_check); Prisma cannot express a cross-column constraint like
// "exactly one of these two is null" and never shows it in this file — the same
// situation as the two partial unique indexes on HndSession (see that model's comment,
// schema.prisma:~1213).
model Notification {
  id        String   @id @default(cuid())
  staff     Staff?   @relation("StaffNotifications", fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String?
  student   Student? @relation("StudentNotifications", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String?
  type      String   @default("info") // info | success | error
  message   String
  link      String? // optional client route hint, e.g. "balance"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([staffId, read])
  @@index([studentId, read])
}

// One announcement a member of staff sent to the students of a unit they teach. The
// DELIVERY is a Notification row per enrolled student (notify.js#notifyStudent — in-app
// feed plus push), so this table is not read by any student surface at all: it is the
// sender's record of what was said, to whom, and when.
//
// The audience is FROZEN AS WORDS AND A COUNT, not derived through the unitId join.
// Enrolment lists move and units get renamed or deleted; the question this row answers
// is "who was told, at the time", and a join would quietly re-answer it with today's
// truth. Same reasoning as Referral.department staying a plain string. unitId is kept
// too — SetNull on delete — but only as a convenience link while the unit lives.
model Announcement {
  id       String @id @default(cuid())
  sender   Staff  @relation("AnnouncementSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId String

  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId String?

  /// "CODE — Name" at the moment of sending.
  audienceLabel  String
  message        String
  /// How many students were enrolled when it was sent. 0 is a real answer here (an
  /// empty unit was announced to), unlike the nullable measurements elsewhere —
  /// nothing about this count is ever unmeasurable at send time.
  recipientCount Int
  createdAt      DateTime @default(now())

  @@index([senderId, createdAt])
}

model CheckIn {
  id        String   @id @default(cuid())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  date      String // YYYY-MM-DD
  timeIn    String
  timeOut   String?
  summary   String   @default("")
  site      String? // HND | FE | Online — where this clock-in happened
  // The NFC sticker this clock-in was made at. NULL for one made by pressing the button
  // in the app, which stays available. Distinguishes "was in the building" from "said
  // they were", without a second boolean that could disagree with it.
  tagId     String?
  createdAt DateTime @default(now())

  @@unique([staffId, date])
}

model Leave {
  id          String  @id @default(cuid())
  staff       Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  type        String // annual | sick | personal | training
  start       String // YYYY-MM-DD
  end         String // YYYY-MM-DD
  days        Int     @default(0) // inclusive day count, computed from start/end at creation
  reason      String  @default("—")
  status      String  @default("pending") // pending | approved | rejected
  requestedAt String
  decidedBy   String?
  decidedAt   String?
  note        String?
}

model Adjustment {
  id      String @id @default(cuid())
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId String
  days    Int
  note    String
  date    String
}

model Document {
  id           String  @id @default(cuid())
  name         String
  type         String // Policy | Payroll | HR | Calendar | Form
  date         String
  scope        String  @default("all") // all | personal
  assignedTo   Staff?  @relation("AssignedDocs", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  // --- The actual file, in Supabase Storage ---
  // All nullable: a Document is a record first and a file second. Rows created before
  // uploads existed stay valid and simply have nothing to open, and an admin can still
  // register a document whose file arrives later.
  //
  // filePath is the key INSIDE the private bucket, never a URL — a stored URL would
  // either be public (wrong for payroll and HR files assigned to one person) or expire
  // and rot in the database. Readable links are signed on demand, after the API has
  // checked the caller may see this document.
  filePath   String?
  fileName   String? // what the uploader called it, for display and download
  mimeType   String?
  sizeBytes  Int?
  uploadedAt DateTime?
}

// ============================================================
// HND student attendance registers
// A unit runs many timetabled sessions; students enrol on
// units; each session has one mark per enrolled student.
// ============================================================

// A teaching period, e.g. "Semester 2" running 01 Feb -> 30 Jun.
// Sessions are not tagged with a semester: a session belongs to whichever
// semester its date falls inside. Ranges are kept non-overlapping (enforced in
// the route layer) so that mapping is always unambiguous.
model Semester {
  id        String   @id @default(cuid())
  name      String
  start     String // YYYY-MM-DD, inclusive
  end       String // YYYY-MM-DD, inclusive
  createdAt DateTime @default(now())
}

// A course of study, e.g. "HND Business". Groups the units (courses) taught
// under it. A unit belongs to at most one course; deleting a course leaves
// its units intact but unassigned (onDelete: SetNull), so registers never vanish.
model Course {
  id             String   @id @default(cuid())
  name           String
  colour         String   @default("#1a3a8f")
  // The Moodle course this was imported from. Set by the VLE sync so a re-run
  // updates this row rather than creating a second copy; null for courses created
  // by hand in the app.
  moodleCourseId Int?
  createdAt      DateTime @default(now())

  /// Which academic department owns this course.
  ///
  /// NULL means "not assigned", which under departmental scoping is visible only to
  /// college-wide accounts. Nothing is backfilled into a default department — see the
  /// 20260904T120000_academic_departments migration for why a seeded "General" bucket
  /// is a silent fail-open.
  academicDepartment    AcademicDepartment? @relation(fields: [academicDepartmentId], references: [id], onDelete: SetNull)
  academicDepartmentId  String?
  /// The VLE's OWN grouping for this course, captured verbatim so the college can map it
  /// to a department once, by hand. Moodle's categoryid, Canvas's account_id,
  /// Blackboard's category.
  ///
  /// Captured even before any mapping exists, because it is free — the sync already has
  /// it in a response it was making anyway — and it is the evidence the mapping screen
  /// is built from. A plain string, not a foreign key: it identifies a row in somebody
  /// else's database, which may be renumbered or deleted without telling us.
  vleCategoryExternalId String?
  /// The grouping's display name, where the token is permitted to read it.
  ///
  /// NULL means "we could not see it", NOT "it has no name". A Moodle whose token lacks
  /// core_course_get_categories still yields ids, and the mapping screen shows those
  /// with their course counts so an admin can name them by looking at what is inside.
  /// Null-is-not-zero, applied to a permission we may not have been granted.
  vleCategoryName       String?

  units           Unit[]
  cohorts         Cohort[]
  timetableSlots  TimetableSlot[]
  termCalendars   TermCalendar[]
  timetableEvents TimetableEvent[]

  @@unique([name])
  @@unique([moodleCourseId])
  @@index([academicDepartmentId])
  @@index([vleCategoryExternalId])
}

// One row of a weekly timetable, shown to students on their app.
//
// Scoped to a COURSE + year + term (the header on the college's timetable reads
// "November 2025 intake — HND … AY 2025-26, Term 3"). A slot need NOT map to a unit:
// alongside taught units and their tutorials it also carries workshops and study
// support ("Academic Skills Workshop", "Study Support") that are not units at all, so
// the title/lecturer/room live on the slot itself. The optional unit link is set when a
// slot was auto-filled from a unit, so a student's enrolment can be matched.
//
// Deliberately separate from HndSession (dated attendance registers): a slot is the
// REPEATING WEEKLY PATTERN a student reads ("Tuesdays 18:00 Operational Planning"),
// a session is one dated class a register is taken for. The admin auto-fills slots
// from a unit's sessions (which supply the weekday and times), then edits them.
model TimetableSlot {
  id         String   @id @default(cuid())
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String?
  year       Int? // 1 | 2 — curriculum year
  termNumber Int? // 1..6 — the college numbers terms straight through both years
  // Set when auto-filled from a unit; null for a hand-added row (workshop/support).
  // SetNull so reorganising units never deletes a published timetable.
  unit       Unit?    @relation("UnitTimetable", fields: [unitId], references: [id], onDelete: SetNull)
  unitId     String?
  day        Int // 1 = Monday … 7 = Sunday (ISO weekday)
  startTime  String // HH:MM, 24h
  endTime    String // HH:MM, 24h
  title      String // what the student sees, e.g. "Operational Planning and Management" or "Study Support"
  lecturer   String   @default("") // free text; defaults from the unit's tutor on auto-fill
  room       String   @default("") // "Online", "Room 101", "Study Room 1st Floor", …
  // Draft until an admin publishes the scope. Students only ever see published rows,
  // so a timetable can be built and edited privately, then released in one go. A row
  // added after publishing starts as a draft again, so the admin decides when it shows.
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Which academic department this belongs to — and here NULL MEANS "SHOWN TO EVERYONE",
  /// which is the opposite of the rule everywhere else in this feature.
  ///
  /// It is the one place fail-OPEN is right, and the reason is what the row IS. `courseId`
  /// is nullable because these deliberately carry sessions that are not units at all —
  /// "Academic Skills Workshop", "Study Support". Scoping them through the course would
  /// fail closed on that null and delete most of what this model exists for from every
  /// departmental tutor's timetable. A workshop is not a student record: hiding it removes
  /// a service, showing it reveals that the college runs a workshop on Tuesday.
  ///
  /// A column rather than a blanket "a null foreign key is public" rule, because a blanket
  /// rule is indistinguishable from somebody forgetting to set a value. Here the null is a
  /// decision, and academicScopeModels.js gives it its own `columnOrNull` kind.
  academicDepartment   AcademicDepartment? @relation(fields: [academicDepartmentId], references: [id], onDelete: SetNull)
  academicDepartmentId String?

  @@index([courseId, year, termNumber])
  @@index([unitId])
  @@index([academicDepartmentId])
}

// The academic calendar for one (course, year, term): the term's start/end dates and a
// week-by-week structure — "Week 1, w.c. 1 Jun, TEACHING … Week 9, w.c. 27 Jul, ASSESSMENT".
// Sits alongside the weekly timetable grid; the college's email shows both. One row per
// scope (upserted). `weeks` is JSON: [{ "n": 1, "wc": "2026-06-01", "activity": "Teaching" }].
// Shares the timetable's publish switch — publishing a scope releases its calendar too.
model TermCalendar {
  id         String   @id @default(cuid())
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String?
  year       Int?
  termNumber Int?
  startDate  String? // YYYY-MM-DD — term start (defaults from the units' dates, editable)
  endDate    String? // YYYY-MM-DD — term end
  weeks      Json     @default("[]")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([courseId, year, termNumber])
}

// An intake of students on a course, e.g. "SEP 2025" or "June 2023". The same
// course runs many cohorts over time; each is a separate group (later, its own
// units and students). Belongs to exactly one course and goes with it if the
// course is deleted.
model Cohort {
  id        String   @id @default(cuid())
  name      String // intake label, e.g. "SEP 2025"
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  startDate String? // optional YYYY-MM-DD — when the intake begins
  createdAt DateTime @default(now())

  terms    Term[]
  units    Unit[]
  students Student[]

  timetableEvents TimetableEventGroup[]
  // This group's own registers. A merged class gives each group its own — see
  // HndSession.cohortId.
  registers       HndSession[]

  // The Microsoft Team provisioned for this cohort, if Teams provisioning has run for
  // it. Optional to-one: most cohorts have none until the automation is switched on
  // and reaches them, and the field stays null forever for a college that never
  // configures the automation at all.
  teamsTeam CohortTeam?

  /// Which academic department runs this intake. Denormalised from the course, exactly as
  /// Student.academicDepartmentId is denormalised through the cohort.
  ///
  /// A COLUMN RATHER THAN A DERIVED PATH, and this one is not a performance choice. The
  /// scope guard's `via` resolves a SINGLE hop and needs the related model to carry the
  /// column itself, so HndSession -> Unit -> Course is unreachable: declared { via: "unit" }
  /// it throws rather than filters. Measured 4 Sep 2026. This column is what makes every
  /// spec 2 path a single hop.
  ///
  /// Maintained by academicDepartments.assignCourses(), the one implementation of "move a
  /// course and everything hanging off it".
  academicDepartment   AcademicDepartment? @relation(fields: [academicDepartmentId], references: [id], onDelete: SetNull)
  academicDepartmentId String?

  @@unique([courseId, name]) // no duplicate intake names within one course
  @@index([courseId])
  @@index([academicDepartmentId])
}

// One teaching term within a cohort. An HND cohort runs 6: Year 1 Terms 1-3 and
// Year 2 Terms 1-3. Each has real dates; the term whose range contains "today" is
// the cohort's ACTIVE term (units in it take attendance; past terms are frozen).
model Term {
  id        String   @id @default(cuid())
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  cohortId  String
  year      Int // 1 | 2
  index     Int // 1 | 2 | 3  (term number within the year)
  name      String // e.g. "Year 1 · Term 1"
  start     String // YYYY-MM-DD, inclusive
  end       String // YYYY-MM-DD, inclusive
  createdAt DateTime @default(now())

  units Unit[]

  @@unique([cohortId, year, index]) // one of each term per cohort
  @@index([cohortId])
}

// A taught HND unit, e.g. code "OBM" / name "Organisational Behaviour Management".
model Unit {
  id              String   @id @default(cuid())
  // Unit codes are unique WITHIN a course, not globally — the same code (e.g. "UNIT 01")
  // may be reused on a different course. Enforced by the composite unique below.
  code            String
  // The Moodle course-section this unit came from, and the Moodle course it sits in.
  // Sections are only unique within their course, hence both.
  moodleSectionId Int?
  moodleCourseId  Int?
  // The unit's number within its course, e.g. "1", "01" or "3a". Free text rather than
  // an Int because awarding bodies use mixed formats, and blank for units that
  // genuinely have no number.
  unitNumber      String   @default("")
  name            String
  tutor           String   @default("")
  course          Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId        String?
  // WHERE THE UNIT SITS IN THE COURSE STRUCTURE — "Year 1 · Term 2".
  //
  // This is curriculum classification, not a calendar: it says which stage of the
  // programme the unit is taught at, and it is what Moodle records (as sections
  // named "Year 1 - Term 1"). Deliberately separate from `term` below, which is a
  // DATED teaching term used to lock registers — Moodle holds no dates, so inventing
  // them there would silently open or lock the wrong registers.
  //
  // Nullable: a unit can sit outside every term section in Moodle, and units added
  // by hand need not be classified. termNumber follows the college's own numbering,
  // which runs on into year 2 (Year 2 is "Term 4"), so it is stored exactly as given.
  year            Int?
  termNumber      Int?
  // WHEN THE UNIT IS TAUGHT — the teaching window, as YYYY-MM-DD.
  //
  // Owned by Staff Hub, not Moodle: Moodle holds no unit dates, and the sync never
  // writes these, so an admin's dates survive every re-import. This is what makes a
  // unit "running now", "finished" or "not started yet", and what the register
  // generator uses as its default date range.
  //
  // Nullable — a unit with no dates is simply unscheduled and counts as neither
  // current nor past, rather than being guessed at.
  startDate       String?
  endDate         String?
  // When work for this unit is due in. Separate from endDate: teaching finishes, then
  // students have a window to submit, and the two are rarely the same day.
  submissionDate  String?
  // The staff member who teaches this unit. `tutor` above stays as free text, for a
  // visiting lecturer with no account and for units assigned before this existed.
  // SetNull, so removing a staff member never deletes the units they taught.
  tutorStaff      Staff?   @relation("UnitTutor", fields: [tutorStaffId], references: [id], onDelete: SetNull)
  tutorStaffId    String?
  // The member of staff who LEADS this module, as distinct from tutorStaff above, who
  // TEACHES it. They are frequently different people and the assessment tracker exists
  // partly to make that visible: the lecturer is chased about a register, the module
  // leader is chased about a marking deadline.
  //
  // Nullable, and that is a measurement decision rather than laziness. A module whose
  // leader has not been named yet is NOT MEASURABLE, not "unassigned" — the tracker
  // renders "—" and excludes it from any count of modules missing a leader, so a
  // college part-way through configuring the page is never reported as having a
  // problem it does not have.
  //
  // SetNull mirrors tutorStaffId exactly: removing a staff account must never cascade
  // into deleting the modules that person led.
  leaderStaff     Staff?   @relation("UnitLeader", fields: [leaderStaffId], references: [id], onDelete: SetNull)
  leaderStaffId   String?
  // A unit can belong to a specific cohort + dated term (the intake and teaching term
  // it runs in). Nullable so existing units and the "just a unit" case still work;
  // set-null on delete keeps registers if a cohort/term is removed.
  cohort          Cohort?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  cohortId        String?
  term            Term?    @relation(fields: [termId], references: [id], onDelete: SetNull)
  termId          String?
  createdAt       DateTime @default(now())

  sessions       HndSession[]
  enrolments     Enrolment[]
  announcements  Announcement[]
  assessments    Assessment[]
  vleEngagement  VleEngagement[]
  studentReviews StudentReview[]
  timetableSlots TimetableSlot[] @relation("UnitTimetable")

  timetableEvents TimetableEvent[]

  // The Teams channel provisioned for this unit within its cohort's Team, if
  // provisioning has reached it. See CohortTeam/UnitChannel.
  teamsChannels UnitChannel[]

  /// Which academic department teaches this unit. Denormalised from the course, exactly as
  /// Student.academicDepartmentId is denormalised through the cohort.
  ///
  /// A COLUMN RATHER THAN A DERIVED PATH, and this one is not a performance choice. The
  /// scope guard's `via` resolves a SINGLE hop and needs the related model to carry the
  /// column itself, so HndSession -> Unit -> Course is unreachable: declared { via: "unit" }
  /// it throws rather than filters. Measured 4 Sep 2026. This column is what makes every
  /// spec 2 path a single hop.
  ///
  /// Maintained by academicDepartments.assignCourses(), the one implementation of "move a
  /// course and everything hanging off it".
  academicDepartment   AcademicDepartment? @relation(fields: [academicDepartmentId], references: [id], onDelete: SetNull)
  academicDepartmentId String?

  @@unique([courseId, code])
  @@index([courseId])
  @@index([cohortId])
  @@index([termId])
  @@index([leaderStaffId])
  @@index([academicDepartmentId])
}

// An assessment belonging to a unit (course) — e.g. "Assignment 1" worth 40%.
// Enrolled students each receive a mark (AssessmentGrade).
model Assessment {
  id             String   @id @default(cuid())
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId         String
  // The Moodle grade item this mirrors (unique per site), plus its course-module id.
  moodleItemId   Int?
  moodleCmid     Int?
  title          String
  type           String   @default("Assignment") // Assignment | Exam | Presentation | Project | Portfolio
  maxMarks       Int      @default(100)
  weight         Int      @default(0) // percentage weighting toward the unit (0 = unset)
  dueDate        String? // YYYY-MM-DD
  // The date by which this assessment's scripts are to be MARKED, as distinct from
  // dueDate above, which is when students hand the work in. Two different deadlines
  // owned by two different people, and the gap between them is what the assessment
  // tracker measures.
  //
  // Deliberately NOT called `deadline`: Unit.submissionDate already exists and means a
  // third thing (the unit's own hand-in window), so an unqualified name here would be
  // genuinely ambiguous to the next reader.
  //
  // Nullable — a college that does not set internal marking deadlines is not late, it
  // is unmeasured, and the tracker must say so rather than show every row as overdue.
  markingDueDate String? // YYYY-MM-DD
  createdAt      DateTime @default(now())

  grades      AssessmentGrade[]
  adjustments AssessmentAdjustment[]
  // Whether the work was handed in, which a grade row cannot answer — a grade only
  // exists once the work has been MARKED. See AssessmentSubmission.
  submissions AssessmentSubmission[]

  @@unique([moodleItemId])
  @@index([unitId])
}

// One student's mark for one assessment. marks is 0..assessment.maxMarks.
model AssessmentGrade {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  marks        Int
  // Where this mark came from: "manual" (typed in the app) or "moodle" (synced).
  // A mark a person typed is never overwritten by a sync.
  source       String     @default("manual")
  // Moodle's own dates (YYYY-MM-DD), so staff can see when the work was handed in
  // and when it was marked in the VLE. Distinct from gradedAt below, which is when
  // the mark landed in Staff Hub.
  submittedAt  String?
  gradedOn     String?
  feedback     String     @default("")
  gradedBy     String?
  gradedAt     DateTime   @default(now())

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

// A student on the HND course. studentRef is the college number used in
// their email (e.g. 100121 -> 100121@edtech.co.uk).
model Student {
  id           String   @id @default(cuid())
  // The Moodle user this student was matched to, so later syncs re-use the match
  // instead of re-resolving by student number/email every time.
  moodleUserId Int?
  // The Microsoft (Entra) user this student was matched to by the Teams attendance
  // sync, so later syncs re-use the match instead of re-resolving by email every time.
  // Same job, same reasoning, as moodleUserId above.
  msUserId     String?
  firstName    String
  lastName     String
  studentRef   String
  email        String
  dob          String? // YYYY-MM-DD — used for birthday emails (optional)
  initials     String
  colour       String
  active       Boolean  @default(true)
  // The intake this student belongs to. Nullable so existing students still load;
  // set-null on delete keeps the student if their cohort is removed.
  cohort       Cohort?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  cohortId     String?
  // --- Student login (the student app) ---
  // NULL until the student has claimed an account (via sign-up + admin approval).
  // A student with no passwordHash cannot sign in. tokenVersion mirrors Staff's:
  // bumping it invalidates their existing sessions.
  passwordHash String?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  enrolments        Enrolment[]
  marks             AttendanceMark[]
  interactions      Interaction[]
  /// Handed to Wellbeing, ASK or Student Support. Cascades with the student, like
  /// every other pastoral record: a deleted student takes their case history with them.
  referrals         Referral[]
  grades            AssessmentGrade[]
  queries           StudentQuery[]
  conductEvents     ConductEvent[]
  reviews           StudentReview[]
  submissions       AssessmentSubmission[]
  // Progression risk. `prediction` is at most one row — the latest score — while
  // predictionHistory keeps every score ever calculated (see those models).
  prediction        StudentPredictionCurrent?
  predictionHistory StudentPredictionHistory[]
  outcomes          StudentOutcome[]
  slcApplications   SlcApplication[]
  admissions        Admission[]
  interventions     Intervention[]
  circumstances     MitigatingCircumstance[]
  vleEngagement     VleEngagement[]
  // The student app's own persisted notification feed and registered push devices —
  // same two models Staff already uses, widened rather than duplicated. See
  // Notification's and DeviceToken's comments for why staffId/studentId are both
  // nullable with exactly one set.
  notifications     Notification[] @relation("StudentNotifications")
  deviceTokens      DeviceToken[]

  /// Which academic department this student belongs to.
  ///
  /// A STORED COLUMN, NOT DERIVED THROUGH THE COHORT, and that is forced rather than
  /// chosen. `cohortId` above is itself nullable, so deriving
  /// Student -> Cohort -> Course -> AcademicDepartment leaves every cohortless student
  /// belonging to no department and therefore invisible to every scoped account. It is
  /// also a two-hop join on the most frequent query in the application.
  ///
  /// The cost is denormalisation drift, and it is paid where the cohort is written:
  /// assigning or changing a cohort writes this column in the same transaction, and
  /// smoke-academic-departments.mjs asserts that it does.
  academicDepartment   AcademicDepartment? @relation(fields: [academicDepartmentId], references: [id], onDelete: SetNull)
  academicDepartmentId String?

  @@unique([moodleUserId])
  @@unique([msUserId])
  @@unique([studentRef])
  @@unique([email])
  @@index([cohortId])
  @@index([academicDepartmentId])
}

// A message a student sends to the college from the student app, and the admin's
// written reply. Two-way: the student sees the response back in their app. Kept as
// a permanent record of every query and its answer.
model StudentQuery {
  id          String   @id @default(cuid())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  subject     String   @default("")
  message     String
  status      String   @default("open") // open | answered
  response    String   @default("") // admin's acknowledgement / written feedback
  respondedBy String? // admin name
  respondedAt String? // YYYY-MM-DD
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([status])
}

// A PAT (Personal Academic Tutor) interaction — a logged meeting/contact with a
// student: what it was about (queryType), a summary, actions and whether a
// follow-up is needed. Mirrors the college's PAT toolkit.
model Interaction {
  id                  String   @id @default(cuid())
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId           String
  date                String // YYYY-MM-DD
  time                String // HH:MM
  queryType           String // e.g. "1 to 1 Meeting", "No Show", "Personal Wellbeing"
  summary             String   @default("")
  followUpActions     String   @default("")
  followUpRequired    Boolean  @default(false)
  followUpDate        String? // YYYY-MM-DD, only meaningful when followUpRequired
  /// WHEN THE PROMISED FOLLOW-UP ACTUALLY HAPPENED. YYYY-MM-DD.
  ///
  /// Nothing recorded this before, so "overdue" had to be faked as
  /// `followUpDate < today` — true for ever, for a follow-up held on the morning it
  /// fell due exactly as much as for one nobody ever made. Every student therefore
  /// accumulated overdue follow-ups monotonically, and the most-wanted signal in the
  /// progression feature could not be built at all.
  ///
  /// A DATE, NOT A BOOLEAN. A follow-up promised for 1 March and held on 30 April
  /// happened, and the two-month gap is the part worth seeing; a boolean throws it
  /// away irrecoverably. Same argument as lastAttendedOn over a stored day count.
  ///
  /// NULLABLE, and the null carries two meanings this row alone cannot separate: no
  /// follow-up was ever promised, and a promised one that has not happened.
  /// followUpDate is what separates them, which is why the route stopped destroying
  /// it. A third meaning applies to every row written before this column existed —
  /// "could not have been recorded" — and the prediction layer refuses to read those
  /// as "not done"; see the watermark in prediction/tripwires.js.
  followUpCompletedOn String?
  /// Who recorded that it happened. A plain string, not a relation, exactly like
  /// loggedBy: closing a safeguarding follow-up is an act the record must still
  /// attribute after that person has left, and a SetNull relation erases precisely
  /// the fact worth keeping. Stamped from the token, never from the body.
  followUpCompletedBy String?
  /// When this row was last written. StudentReview has carried one since it was
  /// created; Interaction did not, and its absence had a consequence beyond tidiness —
  /// the prediction layer needs to know when a follow-up COMPLETION was first recorded
  /// anywhere in the college, and the completion DATE cannot answer that because staff
  /// legitimately backdate it ("promised for 1 March, held on 30 April"). Without an
  /// update stamp the only available watermark was a backdatable claim, and one honest
  /// backdated entry would have re-opened months of history in a single run.
  updatedAt           DateTime @default(now()) @updatedAt
  tutor               String   @default("") // staff member who conducted the meeting
  loggedBy            String? // who recorded the interaction
  createdAt           DateTime @default(now())

  /// Referrals raised out of this meeting. Optional on the far side — most meetings
  /// produce none, and a referral can exist with no meeting behind it.
  referrals Referral[]

  @@index([studentId])
  @@index([followUpRequired])
}

// Links a student to a unit. A student is only listed on a unit's
// register while this row exists.
model Enrolment {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    String
  createdAt DateTime @default(now())

  @@unique([studentId, unitId])
  @@index([unitId])
}

// One timetabled class for a unit — the row shown in the sessions list.
model HndSession {
  id              String   @id @default(cuid())
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId          String
  date            String // YYYY-MM-DD
  startTime       String // HH:MM
  endTime         String // HH:MM
  description     String   @default("")
  audience        String   @default("All students")
  // What kind of session this register is, e.g. "Teaching" or "Seminar". On a
  // 6-hour day the first register is Teaching and the second Seminar.
  kind            String   @default("")
  // The Moodle attendance session this register was imported from. NULL for every
  // register created in Staff Hub itself. It exists so an import can be (a) re-run
  // without duplicating anything and (b) removed again in one statement, without
  // touching a single register a member of staff took by hand.
  moodleSessionId Int?
  // The Teams meeting this register's class ran in. All four are NULL for a class
  // that was never online. joinUrl arrives by calendar discovery or by an admin's
  // paste on the timetable event; meetingId + organizerId are resolved from it once
  // (every Graph artifact fetch is addressed through the meeting's ORGANIZER);
  // collectedAt marks the attendance report as fetched and written, so the poller
  // knows this register is done. NULL collectedAt with a joinUrl set means "still
  // eligible" — the retry, bounded to 7 days, is simply that this stays NULL.
  teamsJoinUrl     String?
  teamsMeetingId   String?
  teamsOrganizerId String?
  teamsCollectedAt DateTime?
  // The lecturer's hand on the self check-in window (3 Sep 2026). Both null means
  // "follow the timetable", which is every session until somebody presses a button.
  //   checkInClosedAt  — the lecturer ended check-in before the timetabled end. Absolute:
  //                      no scan or tap lands while it is set. Reopening clears it.
  //   checkInOpenUntil — HH:MM, local. Holds check-in open PAST the end for late
  //                      arrivals; it only ever extends (the later of end/openUntil wins).
  // On the session, not in a settings row, because the answer is per class per day and
  // an audit reading a disputed register wants it beside the marks it explains.
  checkInClosedAt  DateTime?
  checkInOpenUntil String?
  createdAt       DateTime @default(now())

  marks AttendanceMark[]
  conductEvents ConductEvent[]

  // The timetabled event this register was built from. NULL for every register created
  // by the three-hour-block generator in routes/hnd.js and by the Moodle import, which
  // is why it cannot be required.
  //
  // SetNull, not Cascade: deleting a timetable entry must never delete attendance.
  // The register survives, unlinked, and stays in the record the college is asked to
  // evidence.
  timetableEvent   TimetableEvent? @relation(fields: [timetableEventId], references: [id], onDelete: SetNull)
  timetableEventId String?
  // WHICH GROUP this register is for. A merged class — one lecture, two intakes —
  // keeps a separate register per group, so the event alone does not identify one.
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  cohortId String?
  // Where the class is. The field the student app has been missing: registers came
  // from hardcoded time blocks, and a block does not know which room it is in.
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId String?

  // UNIQUENESS IS TWO PARTIAL INDEXES, NOT AN @@unique HERE, AND PRISMA CANNOT SEE THEM.
  //
  // This model carried @@unique([unitId, date, startTime]). It stopped a second
  // generate run on a different weekday creating a whole parallel set of registers —
  // silently doubling every attendance denominator — and stopped two concurrent
  // generates creating exact duplicates. That guarantee still holds, unchanged, for
  // generator- and Moodle-created registers: HndSession_generated_key applies it
  // WHERE "timetableEventId" IS NULL.
  //
  // That index carries COALESCE("cohortId", '') as a FOURTH column since
  // 20260909T120000_merged_register_delete, and the reason is a delete rather than an
  // insert. timetableEventId is SetNull, so deleting a timetable entry MOVES its
  // registers from the event index to this one — and a merged class's registers differ
  // only by cohortId, so without that column they collapsed onto one key and collided
  // with each other. Deleting any class with two or more groups answered 500. Generated
  // registers carry no cohortId, so they all coalesce to '' and the duplicate-generation
  // guarantee binds them exactly as before.
  //
  // But a MERGED CLASS legitimately needs two registers for one module at one start
  // time, one per group, and the old constraint forbade exactly that. Timetable-created
  // registers are therefore identified by HndSession_event_group_key, on
  // ("timetableEventId", COALESCE("cohortId", '')). The COALESCE is load-bearing:
  // Postgres treats NULLs as distinct, so a plain two-column unique would accept
  // unlimited duplicate registers for any event with no group — reopening the exact
  // hole the original constraint existed to close.
  //
  // Both live in prisma/migrations/20260907T120000_timetabling_registers as raw SQL,
  // and HndSession_generated_key was widened in 20260909T120000_merged_register_delete.
  // Prisma cannot express a partial unique index, so `prisma migrate dev` sees them as
  // drift and would drop both, and nothing would notice until duplicate registers
  // appeared in production. timetabling/schema-contract.test.js asserts this comment is
  // still here and that the @@unique has not been reinstated.
  @@unique([moodleSessionId])
  @@index([unitId, date])
  @@index([timetableEventId])
  @@index([cohortId])
  @@index([roomId])
}

// One student's mark for one session. status is P | L | E | A
// (Present | Late | Excused | Absent) — validated in the route layer rather than by a
// Prisma enum. That began as a SQLite limitation; on Postgres it is a deliberate choice,
// for the reason given above Staff.
model AttendanceMark {
  id          String     @id @default(cuid())
  session     HndSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  status      String // P | L | E | A
  remark      String     @default("")
  takenBy     String? // staff name who took the register
  takenAt     DateTime   @default(now())
  // When the student actually tapped in. NULL when nobody self-checked-in — the lecturer
  // marked them by hand — which is "not measurable", not an early arrival.
  //
  // Written ONCE and never again. A later register save must not overwrite it: takenAt
  // is already reset on every update (the register save writes `takenAt: new Date()`),
  // so it means "when this mark was last edited", and a lecturer correcting the register
  // at four o'clock would otherwise destroy the only record of the 09:07 arrival.
  //
  // A string, not a DateTime, matching CheckIn.timeIn: the session carries the date, so
  // the two reconstruct the instant, and a time written through clock.localTime() is
  // right when stored and stays right. STATUS.md records D8 — the 08:00 notifications
  // firing at 09:00 through BST because something read the host clock — which is the bug
  // a stored instant re-zoned at every render invites back.
  checkedInAt String? // "HH:MM:SS" for self check-ins (scan/tap/declare), "HH:MM" for Teams marks and rows written before seconds were recorded; London
  // WHICH HANDSET this mark was made from, when the student made it themselves.
  //
  // NULL for every mark a member of staff set, and that is the common case rather than an
  // omission — a lecturer taking a register is not checking in from a device, and writing
  // their browser's id here would make "no device" indistinguishable from "the lecturer's
  // laptop" in exactly the comparison this column exists for.
  //
  // NOT AN IDENTITY, and never treated as one. It is a random value the app made up once
  // and kept; clearing site data mints a new one, so it can be shed by anybody who wants
  // to and it can never be the thing a refusal rests on. What it CAN do is answer the
  // question the brief actually asks -- "no other student should be able to log in with
  // another student's credentials and mark them present" -- because the detectable shape
  // of that is not a login at all. It is TWO STUDENT ACCOUNTS MARKED FROM ONE HANDSET IN
  // ONE CLASS, which is visible here and nowhere else.
  //
  // Written once, at check-in, and never by a register save. A lecturer correcting a mark
  // at four o'clock must not overwrite the record of which handset made it — the same rule
  // as checkedInAt above, and for the same reason.
  //
  // It NEVER leaves the building. No serialiser publishes it; the screens receive only the
  // derived "shares a handset with these other students on this register". A random
  // tracking identifier handed to a browser is a tracking identifier, whatever it was
  // collected for.
  deviceId    String?

  @@unique([sessionId, studentId])
  @@index([studentId])
  // NO INDEX ON deviceId, and that is deliberate rather than an omission.
  //
  // One was added with the column on 10 Sep 2026, its comment claiming "the collision
  // query: every mark on one register, grouped by handset". No such query was ever
  // written — sharedDevice.js groups in JavaScript over marks the register read has
  // already loaded in full, and the only lookup either caller makes is by sessionId, which
  // the unique above already serves as a prefix. It was write cost on every insert in
  // exchange for nothing, and the comment was the more expensive half: it invited the next
  // reader to reason from a query that did not exist. Dropped by
  // 20260911T120000_drop_unused_mark_device_index.
}

// A registered NFC sticker. One per room, and the SAME sticker serves students and
// staff — the server branches on who is signed in, not on which tag was touched, so a
// college prints one sticker per room rather than two.
model AttendanceTag {
  id        String    @id @default(cuid())
  // The secret written onto the sticker. Opaque and random, and deliberately NOT a URL.
  // Our own app reads it, so there is nothing to gain from it being clickable and a lot
  // to lose: a readable link is one a student can read off the wall with any phone and
  // replay from home. Globally unique rather than unique-per-tenant so a code is never
  // ambiguous about which college it belongs to.
  code      String    @unique
  label     String // "Room 101", "Reception"
  active    Boolean   @default(true) // deactivate a peeled-off or lost sticker
  // NULL until the first tap. "Never used" is not a zero date, and a college auditing
  // its stickers needs to tell the two apart.
  lastTapAt DateTime?
  createdAt DateTime  @default(now())
  createdBy String?
  taps      TagTap[]
}

// Every tap, accepted or refused, for students and staff alike.
//
// The refusals are the valuable half. "I did tap and it didn't work" is a question
// attendance evidence has to be able to answer, and a pattern — one address checking in
// six students inside a minute — is invisible in AttendanceMark and obvious here.
model TagTap {
  id        String         @id @default(cuid())
  // NULLABLE, and that is the whole point of this column's existence being awkward.
  // The refusals an administrator is most often asked about — "I tapped and it didn't
  // work" — happen BEFORE any tag is identified: an unknown code matches nothing, a
  // retired sticker is filtered out by the lookup, a rate-limited or switched-off tap
  // never reaches the lookup at all. A required foreign key made those three outcomes
  // literally unwritable, so the vocabulary below listed them and nothing ever produced
  // one. A tap with no tag is a real event and now leaves a real row.
  tag       AttendanceTag? @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String?
  // Exactly one of these is set on an accepted tap; BOTH are null when the tap was
  // refused before anybody was identified. Not measurable — never a blank string
  // standing in for a person.
  studentId String?
  staffId   String?
  sessionId String? // the register a student tap landed on
  // "nfc" | "qr" | "declared" | "teams" | "button". NULLABLE, and never backfilled: a row
  // written before this column existed is not evidence that it was NFC, it is evidence
  // that we were not recording the method — writing "nfc" onto it would invent a fact. An
  // administrator answering "I scanned and it did not work" needs to know which capture
  // path refused, because the two fail differently: a dead sticker and an expired code
  // look identical in a log that does not say.
  //
  // "declared" (self check-in with no evidence beyond the account being signed in) and
  // "teams" (written by the meeting-attendance sync, never by a person tapping anything)
  // both predate this comment's last edit and are added here for the same reason the rest
  // of this list exists: a value the routes write but this comment does not name is one
  // nobody knows to look for. "button" is new with staff presence (21 Sep 2026) — a
  // refusal logged for the plain On site button, where no sticker was involved at all;
  // see refusedForStaffPlace in routes/checkins.js.
  method    String?
  // What happened, in one word. Kept as a list here because this column is the vocabulary
  // an administrator reads the tap log through, and a value that exists in the routes but
  // not in this comment is one nobody knows to look for.
  //
  //   marked | checked_in | already_marked | already_checked_in | no_session_now |
  //   ambiguous | term_locked | tag_unknown | rate_limited | disabled |
  //   qr_expired | qr_bad_code | session_unknown | not_enrolled
  //
  // ...and, since 10 Sep 2026, WHERE the phone was rather than what it did. These are the
  // presence checks, and they split into two kinds that send a reader somewhere different:
  //
  //   off_network | off_campus | position_missing | accuracy_unknown | accuracy_too_poor
  //       — the caller is not where the college requires, or their phone cannot say. Until
  //         21 Sep 2026 "the caller" always meant a student; staff presence (§3.14,
  //         STATUS.md) added `refusedForStaffPlace` in routes/checkins.js, which writes
  //         these same five reasons for a staff Onsite clock-in, so this half of the
  //         column is now read by both audiences.
  //   network_not_configured | campus_not_located
  //       — the COLLEGE's own settings are refusing everybody. These two are also written
  //         to the service log with console.error, because a misconfiguration that refuses
  //         an entire institution is invisible from the outside.
  //
  //   ...and, since 12 Sep 2026, the Teams attendance sync (method "teams") writes:
  //   marked          — a mark was written from the meeting's attendance report
  //   already_marked  — the report agreed or disagreed with a mark that already stood;
  //                     either way the standing mark won
  outcome   String
  status    String? // "P" | "L" when a mark was actually written
  site      String? // "Onsite" on every staff row, written by a tap AND (since 21 Sep
  // 2026, staff presence) by a plain On site button refusal with method: "button" — a row
  // where nothing was tapped at all. Neither method proves the claim by itself; see "What
  // this can and cannot prove" in the staff presence design doc and STATUS.md §3.14.
  at        DateTime       @default(now())
  ip        String?
  // An id the student's app made up once and keeps (localStorage), sent as a header on
  // every self check-in. Not identity — the account is — but the trail that answers
  // "did one handset scan for six accounts in a minute". Null before the column existed
  // and for clients that never send one; never used to refuse a scan on its own.
  deviceId  String?

  @@index([tagId, at])
  @@index([studentId])
  @@index([staffId])
}

// Per-college settings for tap check-in.
//
// Same shape as AttendanceBandConfig, which is the reference implementation: platform
// defaults in code, one JSON column merged over them, no row until a college edits
// something, an allowlist on the way out, and a short cache invalidated on save. The
// defaults have enabled:false, so an unconfigured college behaves exactly as it did
// before this feature existed.
model AttendanceTapConfig {
  id        String   @id @default("singleton")
  settings  Json     @default("{}")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Whether the Teams attendance sync runs, and what "present" requires. Same shape as
// AttendanceTapConfig above (the reference implementation is AttendanceBandConfig):
// defaults in code with enabled:false, one JSON column merged over them, constant
// "singleton" key, allowlist on the way out, short cache invalidated on save.
model TeamsAttendanceConfig {
  id        String   @id @default("singleton")
  settings  Json     @default("{}")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// One line on a staff member's timesheet: a class or work session on a given day,
// with its clock times, whether it was delivered on campus or online, and how many
// minutes it ran. Entries start as "draft"; "Send timesheet" flips a whole month's
// entries to "submitted" and notifies admins. minutes is stored (not just derived)
// so monthly/daily totals aggregate in the database without re-parsing every row.
model TimesheetEntry {
  id          String   @id @default(cuid())
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  date        String // YYYY-MM-DD (local London date)
  startTime   String // HH:MM 24h — when the class/session started
  endTime     String // HH:MM 24h — when it ended
  minutes     Int // duration in minutes (endTime - startTime), stored for aggregation
  mode        String   @default("campus") // campus | online
  title       String // what it was, e.g. "Unit 4 — Database Design (Group A)"
  unitId      String? // optional free link to an HND unit (no FK: keeps it flexible)
  note        String   @default("")
  // Approval workflow: draft → submitted → (finance) approved | changes_requested.
  // "changes_requested" bounces the month back to the staff member with reviewNote
  // explaining what to fix; they edit and re-send, returning it to "submitted".
  status      String   @default("draft") // draft | submitted | approved | changes_requested
  submittedAt String? // YYYY-MM-DD when the month was sent
  reviewNote  String? // finance team's comment when requesting changes (or on approval)
  reviewedBy  String? // name of the finance/admin reviewer
  reviewedAt  String? // YYYY-MM-DD of the review decision
  createdAt   DateTime @default(now())

  @@index([staffId, date])
  @@index([staffId, status])
}

// One row per VLE sync run - what was created/updated, and anything that needed a
// human. Keeping the history means "why did this student not import?" is answerable
// after the fact instead of only in the moment.
model MoodleSync {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | ok | failed
  mode       String    @default("manual") // manual | scheduled | preview
  startedBy  String? // admin name, or null for the nightly run
  // Counters, as JSON: courses/units/assessments/students/grades created & updated.
  summary    String    @default("{}")
  // Anything skipped or unmatched, as a JSON array of readable messages.
  issues     String    @default("[]")
  error      String?

  @@index([startedAt])
}

// One row per Teams attendance sync run — what was matched, written and skipped, and
// anything that needs a human (an unmatched meeting, a participant whose email fits no
// student). Same job and shape as MoodleSync above.
model TeamsSync {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | ok | failed
  mode       String    @default("manual") // manual | scheduled
  startedBy  String? // admin name, or null for the scheduled run
  // Counters, as JSON: meetingsDiscovered, sessionsMatched, sessionsAmbiguous,
  // reportsFetched, marksCreated, marksSkippedExisting, participantsUnmatched.
  summary    String    @default("{}")
  // Anything skipped or unmatched, as a JSON array of readable messages.
  issues     String    @default("[]")
  error      String?

  @@index([startedAt])
}

// One provisioned class space per cohort. Additive-only: rows are created and
// updated by teamsProvisioning.js and never deleted by it — deleting the row would
// orphan the Team in Microsoft with nothing linking it back.
model CohortTeam {
  id           String    @id @default(cuid())
  cohort       Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  cohortId     String
  // Microsoft's group id (the Team's underlying group) — the handle every later
  // channel/membership call addresses.
  groupId      String
  displayName  String
  createdAt    DateTime  @default(now())
  lastSyncedAt DateTime?
  channels     UnitChannel[]

  @@unique([cohortId])
}

// One channel per unit inside a cohort's Team. channelEmail is cached because it is
// how the meeting invite reaches the channel (app-only cannot post messages), and
// null records "this tenant has channel email disabled" after one failed read —
// distinct from "never fetched", which is the empty string default's job. The
// `@default("")` was added by the engine review that noticed this comment promised
// three states while the column, with no default, actually collapsed "never
// fetched" into the same NULL as "confirmed none" for any row inserted without
// naming a value — teamsProvisioning.js now relies on this default to tell the two
// apart and retry only the genuinely-never-fetched rows.
model UnitChannel {
  id           String     @id @default(cuid())
  cohortTeam   CohortTeam @relation(fields: [cohortTeamId], references: [id], onDelete: Cascade)
  cohortTeamId String
  unit         Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId       String
  channelId    String
  channelEmail String?    @default("")
  createdAt    DateTime   @default(now())

  @@unique([cohortTeamId, unitId])
}

// Run log for both automations — `job` says which. Mirror of TeamsSync above.
model TeamsProvisionSync {
  id         String    @id @default(cuid())
  job        String // "meetings" | "provisioning"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | ok | failed
  mode       String    @default("manual") // manual | scheduled
  startedBy  String? // admin name, or null for the scheduled run
  // Counters, as JSON — shape depends on `job`, exactly as TeamsSync.summary above.
  summary    String    @default("{}")
  // Anything skipped or unmatched, as a JSON array of readable messages.
  issues     String    @default("[]")
  error      String?

  @@index([startedAt])
}

// The ONE recurring Teams meeting that covers a whole timetable series (every weekly
// occurrence sharing a TimetableEvent.seriesId). A recurring meeting belongs to the
// series, not to any one occurrence, so it gets its own row rather than being pinned to
// an arbitrary "first" event. One-off events (seriesId null) keep using the per-event
// columns on TimetableEvent instead — see teamsMeetings.js's two passes.
model TeamsSeriesMeeting {
  id       String @id @default(cuid())
  // The TimetableEvent.seriesId this meeting covers. Unique: one recurring meeting per
  // series, and the lookup key the reconcile uses.
  seriesId String @unique
  // The recurring Graph calendar event (the series master) on the creator's calendar,
  // so a later run can PATCH or DELETE it. Set only by the machine.
  calendarEventId String
  joinUrl         String
  // The stable onlineMeeting id behind joinUrl, resolved once — needed for the
  // co-organizer write and for attendance collection.
  meetingId   String?
  // The creator account's Entra id (every Graph artifact fetch is addressed through it).
  organizerId String
  // subject|firstDate|lastDate|weekdays|startTime|endTime|sorted(attendees)|sorted(staff).
  // The reconcile PATCHes the meeting only when this differs from a freshly computed one,
  // the same gate teamsMeetings.js's per-event meetingFingerprint provides.
  fingerprint String
  // When co-organizer roles were last written, so an unchanged staff set is not
  // re-written on every hourly tick.
  coorganizersSetAt DateTime?
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([seriesId])
}

// Whether the Teams meeting/provisioning automations run, and their settings. Same
// shape as TeamsAttendanceConfig above: defaults in code with enabled:false, one JSON
// column merged over them, constant "singleton" key, allowlist on the way out, short
// cache invalidated on save.
model TeamsAutomationConfig {
  id        String   @id @default("singleton")
  settings  Json     @default("{}")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// A completed staff review — the Strategic Lecturer Self-Reflection, the Monthly
// Performance & Support Review, or any later form.
//
// The ANSWERS are stored as JSON rather than one column per question. The strategic
// form alone has 26 questions, the monthly form adds its own, and more will follow —
// a column each would mean a schema migration every time a question is reworded. The
// questions live in src/reviewForms.js, which validates every answer on the way in,
// so what lands here is never free-form.
//
// The handful of fields worth filtering and sorting by are lifted into real columns
// so the list view never has to parse the blob.
model StaffReview {
  id            String   @id @default(cuid())
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId       String
  type          String // "strategic" | "monthly"
  term          String   @default("") // e.g. "Term 2", or the month for a monthly review
  academicYear  String   @default("")
  dateCompleted String? // YYYY-MM-DD
  status        String   @default("submitted") // draft | submitted
  answers       String   @default("{}") // JSON, validated against the form
  completedBy   String? // whoever recorded it
  origin        String   @default("admin") // admin | self (submitted by the lecturer)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([staffId])
  @@index([type])
  @@index([status])
}

// A lecturer's review of one student on one unit — the "Student Review" a staff
// member files from the app after a progress conversation.
//
// Visible to THREE audiences: the lecturer who wrote it, the student it is about,
// and administrators. The student seeing it is deliberate — it is a record of a
// conversation they took part in — so the wording of `summary` and `agreedActions`
// should read as something you would say to their face.
model StudentReview {
  id                  String   @id @default(cuid())
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId           String
  // The unit the conversation was about. Nullable and set-null on delete, so
  // reorganising units never destroys a pastoral record.
  unit                Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId              String?
  // The lecturer who filed it. Kept even if they later leave, so the record still
  // says who wrote it — hence the name is copied into staffName.
  staff               Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId             String?
  staffName           String   @default("")
  date                String // YYYY-MM-DD — when the conversation happened
  progress            String // On Track | Monitor | At Risk
  // "Select all that apply", as a JSON array. Validated against a fixed list.
  concerns            String   @default("[]")
  summary             String   @default("")
  agreedActions       String   @default("")
  followUp            Boolean  @default(false)
  followUpDate        String? // YYYY-MM-DD, only when followUp is true
  /// When the promised follow-up actually happened, YYYY-MM-DD. See the identical
  /// pair on Interaction for the full argument — the two must stay the same shape,
  /// because the prediction layer counts missed follow-ups across BOTH tables and a
  /// signal that could see only half of them would be worse than none, since which
  /// half depends on which screen a tutor happens to use.
  followUpCompletedOn String?
  /// Who recorded it. A plain string, for the reason staffName above is one.
  followUpCompletedBy String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Interventions raised off the back of this conversation, if any. Set-null on
  // the other side, so deleting a review keeps its interventions.
  interventions Intervention[]

  @@index([studentId])
  @@index([staffId])
  @@index([followUp])
  @@index([date])
}

// A submitted HND application (admissions). One row per applicant, entered by an admin
// from the college's application form. All fields are free text (dates kept as strings)
// so the form can evolve without migrations; the admin fills what they have.
model Admission {
  id                     String  @id @default(cuid())
  // Course details
  course                 String?
  // The intake: a month (January | April | June | September) plus a year. Combined
  // ("September 2026") they drive the SharePoint folder: Admissions / <course> /
  // <intake year> / <student name> / documents.
  intake                 String?
  intakeYear             String?
  foundVia               String?
  classOption            String?
  firstName              String?
  middleName             String?
  surname                String?
  dob                    String?
  gender                 String?
  email                  String?
  phone                  String?
  countryOfBirth         String?
  countryOfCitizenship   String?
  idDocNo                String?
  idDateOfIssue          String?
  idDateOfExpiry         String?
  idIssuingCountry       String?
  niNumber               String?
  // Home address
  houseNo                String?
  street                 String?
  city                   String?
  postCode               String?
  mailingAddress         String?
  emergencyName          String?
  emergencyPhone         String?
  emergencyRelationship  String?
  emergencyEmail         String?
  // Criminal record declaration
  criminalConviction     String?
  criminalDetails        String?
  // Disabilities
  medicalConditions      String?
  medicalDetails         String?
  learningDifficulty     String?
  learningDetails        String?
  // Education & employment
  englishFirstLanguage   String?
  englishProof           String?
  englishProofOther      String?
  highestEducation       String?
  overseasQualification  String?
  appliedElsewhere       String?
  previousStudentFinance String?
  previousFinanceDetails String?
  fundingIntent          String?
  fundingOther           String?
  employmentStatus       String?
  employmentDetails      String?
  jobTitle               String?
  companyName            String?
  dateStarted            String?
  workedPast             String?
  workedPastDetails      String?
  // Reference 1
  ref1Name               String?
  ref1Contact            String?
  ref1Email              String?
  ref1Relationship       String?
  // Reference 2
  ref2Name               String?
  ref2Role               String?
  ref2Organisation       String?
  ref2Relationship       String?
  // EDI
  ethnicity              String?
  religion               String?
  // Declaration
  signature              String?
  declarationDate        String?

  /// The enrolled Student this application became.
  ///
  /// DISTINCT FROM `studentId` above, which is the college ID an admin TYPED — a
  /// string, not a reference, and the field this one exists because of. The name is
  /// ugly on purpose: two columns called studentId on one table, one a foreign key and
  /// one a typed label, is how somebody later attaches the wrong person's document
  /// expiry to a student.
  ///
  /// NULLABLE. Most applicants never become students — they are rejected, they
  /// withdraw, or they go elsewhere. NOT NULL would make the table unwritable at the
  /// only moment it is written.
  linkedStudent     Student?  @relation(fields: [linkedStudentId], references: [id], onDelete: SetNull)
  linkedStudentId   String?
  studentLinkSource String?
  studentLinkedAt   DateTime?

  /// The parsed, VALIDATED form of idDateOfExpiry above, which is free text with no
  /// format check and legitimately holds "12/05/2027", "May 2027" or "N/A". Comparing
  /// that against YYYY-MM-DD produces confident WRONG answers rather than errors —
  /// "12/05/2027" sorts before "2026-09-01" and reads as already expired, while
  /// "May 2027" sorts after and reads as never expiring. Two of the three commonest
  /// junk values give a false all-clear.
  ///
  /// EVERY CONSUMER READS THIS AND NEVER THAT ONE. The rule is greppable, and it is
  /// the point of having two columns. Null unless exactly one date was possible.
  idExpiryOn     String?
  /// "parsed" | "ambiguous" | "unparseable" | "confirmed". "confirmed" is a human's
  /// assertion and outranks a machine parse, matching AssessmentGrade.source. Null
  /// means not yet examined.
  idExpiryStatus String?

  // --- Document upload (after the application is entered) ---
  // Set when an admin emails the applicant asking them to upload their documents.
  docsRequestedAt    DateTime?
  // The applicant's upload link is a single long-lived, reusable token (they may add
  // documents over several days). Only the SHA-256 HASH is stored — the raw value
  // lives solely in the emailed link, so this table leaks nothing usable.
  uploadTokenHash    String?   @unique
  uploadTokenExpires DateTime?
  // The applicant's folder in SharePoint (Graph driveItem id + web URL), created the
  // first time documents are requested/uploaded. Null until then / if SharePoint is
  // not configured (the Supabase fallback needs no folder).
  spFolderId         String?
  spFolderUrl        String?

  // --- Admissions decision (set manually by an admin) ---
  interviewStatus String? // legacy manual field — superseded by the ISM "Admitted?" outcome
  enrollStatus    String? // "Enroll" | "Rejected" | null (= pending)
  studentId       String? // college student ID, typed in by an admin
  // Mirror of the linked ISM (Intention to Study Meeting) outcome — "Yes" | "No" | "May Be" —
  // so the Admissions list can show it without joining. Written by the ISM routes.
  ismOutcome      String?

  // --- Offer letter ---
  // offerStatus: null (not sent) | "sent" | "accepted". The applicant accepts via a
  // secure link (hashed token, like the upload link); the raw value lives only in the
  // email. offerInductionDate is the first-day date the admin picked when sending.
  offerStatus        String?
  offerSentAt        DateTime?
  offerAcceptedAt    DateTime?
  offerInductionDate String?
  offerSignatoryName String?
  offerTokenHash     String?   @unique

  // --- Applicant portal login ---
  // A prospective student can self-register and sign in to track their application (fill
  // the form, upload documents, see the offer and interview). passwordHash is NULL for
  // records created by an admin or the public apply form (they have no login). Login is
  // the shared /api/auth/login, issuing a kind:"applicant" token confined to /api/applicant.
  // Email uniqueness (vs Staff, Student and other applicant accounts) is enforced in code.
  passwordHash           String?
  active                 Boolean   @default(true)
  tokenVersion           Int       @default(0)
  // Set when the applicant presses "Submit application" in the portal — drives the
  // progress tracker. Null = still a draft. Independent of admin-created records.
  applicationSubmittedAt DateTime?
  // How this record was created, for the admin list: "portal" (self-registered),
  // "apply" (public form) or null/"admin" (entered by an admin).
  source                 String?

  // --- Interview call (invitation) ---
  // The admin schedules an interview; the applicant sees it in the portal and is emailed.
  // Distinct from Ism.interviewDate (which records when the meeting actually happened).
  interviewInviteDate     String? // YYYY-MM-DD
  interviewInviteTime     String? // HH:MM
  interviewInviteMode     String? // "Online" | "In person"
  interviewInviteLocation String? // room / address (in-person)
  interviewInviteLink     String? // meeting link (online)
  interviewInviteNote     String?
  interviewInviteSentAt   DateTime?

  // --- Enrolment induction (set when an admin clicks Enroll) ---
  enrolInductionDate String? // YYYY-MM-DD
  enrolInductionTime String? // HH:MM
  enrolEmailSentAt   DateTime?

  documents AdmissionDocument[]
  isms      Ism[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surname, firstName])
  // Declared here because the database already has it: migration
  // 20260828T230000_link_finance_to_student created Admission_linkedStudentId_idx,
  // and this model never said so. The schema and the database therefore disagreed,
  // and Prisma swept a DROP INDEX for it into the NEXT migration generated for any
  // reason at all — which is how an unrelated production index came to be inside a
  // timetabling migration. Declaring it makes the schema honest and the drop go away.
  @@index([linkedStudentId])
}

// An Intention to Study Meeting (ISM) — the admission interview record. Linked to an
// applicant (admissionId); the "admitted" outcome is mirrored onto Admission.ismOutcome
// so the Admissions list shows it. All answers are free text so the form can evolve.
model Ism {
  id                  String     @id @default(cuid())
  admission           Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  admissionId         String?
  name                String?
  courseUnderstanding String?
  lastStudied         String?
  independentLearning String?
  educationExperience String?
  strengthsWeaknesses String?
  prioritiseWorkload  String?
  working             String?
  teamworkExample     String?
  wifiAccess          String? // Yes | No
  officeSkills        String? // Yes | No
  admitted            String? // Yes | No | May Be
  interviewerName     String? // the admin who recorded the meeting
  interviewDate       String? // YYYY-MM-DD
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([admissionId])
}

// One uploaded document belonging to an application. There is at most one row per
// (application, docType) — re-uploading replaces the file and clears verification.
// The bytes live in SharePoint (spItemId/webUrl) or, when SharePoint is not yet
// configured, in Supabase Storage (storagePath) — backend is an implementation detail
// the admin UI does not need to care about.
model AdmissionDocument {
  id          String    @id @default(cuid())
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  admissionId String
  docType     String // passport | english | qualifications | address | ni | immigration
  fileName    String
  mimeType    String?
  sizeBytes   Int?
  // SharePoint (Microsoft Graph) location, when stored there.
  spItemId    String?
  webUrl      String?
  // Supabase Storage key, when SharePoint is not configured (fallback).
  storagePath String?
  uploadedAt  DateTime  @default(now())
  // An admin has eyeballed the file in SharePoint and signed it off.
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  confirmedBy String?

  @@unique([admissionId, docType])
  @@index([admissionId])
}

// Admissions-managed course list — the courses shown on the application form's course
// dropdown. Deliberately SEPARATE from the Moodle-synced `Course` table: admissions
// decides what a prospective student can apply for, independent of what's live in Moodle.
model AdmissionCourse {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true) // hidden from the form when false, without deleting
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// The course fee, in PENCE, for the Admission Tracker's estimated-revenue tile.
  ///
  /// NULLABLE, AND THAT IS THE POINT. Null means "this college has not told us what
  /// this course costs" — not "this course is free". The tracker excludes a fee-less
  /// course's enrolments from the estimate entirely and reports the coverage beside
  /// the figure ("estimated from 4 of 6 courses"), because an unset fee silently read
  /// as zero under-reports revenue on an executive screen with nothing to indicate it.
  /// Null-is-not-zero, the same rule the prediction engine runs on.
  ///
  /// INTEGER PENCE, not a decimal and emphatically not free text. `SlcApplication.amount`
  /// is a String holding things like "£9,250" and is unusable for arithmetic; this
  /// column exists partly so that mistake is not made twice.
  ///
  /// This whole tile is a PLACEHOLDER for real finance data once SLC is developed. The
  /// arithmetic lives in exactly one function — `estimateRevenue` in
  /// src/admissions/stats.js — so swapping the source later is one edit, not a hunt.
  feeAmountPence Int?
}

/// Single-row config for the Admission Tracker. `data` is a JSON blob merged over the
/// code defaults in src/admissions/trackerSettings.js, holding:
///
///   { targets: { default: {...}, byIntake: { "September 2026": {...} } },
///     requiredDocTypes: ["photo", "passport", ...] }
///
/// `requiredDocTypes` exists because ADMISSION_DOC_TYPES has ten entries and NONE is
/// marked optional. "Documents complete = all ten" reads artificially low — an
/// immigration share code does not apply to a UK national — and inventing a required
/// subset in code would impose one college's admissions rules on every other. So the
/// set is configurable and defaults to all ten.
model AdmissionTrackerSettings {
  /// A CONSTANT PRIMARY KEY, and the save path upserts on this literal.
  ///
  /// This is the sixth config table of this shape (see TenantBranding,
  /// AttendanceBandConfig, PredictionModelSettings, AttendanceTapConfig,
  /// TimetableSettings) and it takes both halves of the pattern for the documented
  /// reason: find-then-create is not atomic, so two administrators saving at the same
  /// moment both find nothing, both insert, and `findFirst` afterwards returns whichever
  /// row the planner picks. The targets an executive dashboard measures against would
  /// become a coin toss between two rows. The constant key makes the second writer
  /// collide with the first instead.
  ///
  /// Reads stay on `findFirst`, because a read that must not create a row should not be
  /// able to, and this key is what guarantees there is at most one row to find.
  id        String   @id @default("singleton")
  data      Json     @default("{}")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Admissions-managed intake list, e.g. "September 2026". A single combined label the
// admin adds/removes here and the applicant picks from on the application form.
model AdmissionIntake {
  id        String   @id @default(cuid())
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Single-row config for the automated monthly attendance emails. `data` is a JSON blob
// holding { autoEnabled, respondDays, sendHour, lastRunPeriod, values{...}, templates{...} }
// merged over the code defaults (see attendanceBands.js / attendanceRunner.js), so the
// shape can evolve without a migration.
model AttendanceEmailConfig {
  /// A PROCESS-GLOBAL primary key, and correct again.
  ///
  /// It began as this. When one database served every institution it became a bug:
  /// every college upserted the same literal id, so the first to save took the row
  /// and every other collided, loadConfig swallowed the error and served defaults,
  /// and the interface showed saved-looking settings that had never been saved. The
  /// key became [tenantId, id] to fix it.
  ///
  /// One deployment now serves one college, so "the same literal id" is the same
  /// row — which is the guarantee this table wants. Restored rather than left
  /// composite, and it is the pattern the other config singletons now follow.
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

/// The attendance bands ONE institution monitors its students against.
///
/// These were six values in the code — 85+, 70–84, 60–69, 50–59, 40–49, 0–39 — which
/// is one college's attendance policy, applied to every college on the platform.
/// Thresholds differ, the NUMBER of bands differs, and which bands warrant an
/// automatic letter differs. See attendanceBandConfig.js.
///
/// At most one row per institution, and no row at all until a college edits its
/// bands: "no row" means "running on the platform defaults", which is exactly how
/// the system behaved before this existed.
model AttendanceBandConfig {
  id String @id @default("singleton")

  /// The whole ladder, best -> worst, as a JSON array of
  /// { key, label, min, max, colour, emailTrigger }.
  ///
  /// One column rather than a row per band, because a band list is only ever valid
  /// as a SET — it must tile 0–100 with no gap and no overlap — and one column
  /// replaces the set atomically. A reader can never catch a half-written ladder and
  /// classify a student against a hole in it.
  ///
  /// `key` is the stable identity a saved email template is filed under, so renaming
  /// a band keeps the letter that belongs to it.
  bands Json

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// The behaviour/merit vocabulary a lecturer taps in class — the tenth table of the
// constant-key shape (configuration.md). One JSON column holding the whole list of
// { key, label, points, tone, notifyStudent, active }, because the list is only
// valid as a SET (keys unique, at least one active) and one column replaces it
// atomically. Defaults, validation and the allowlist live in src/conductConfig.js.
model ConductVocabularyConfig {
  id         String   @id @default("singleton")
  vocabulary Json
  updatedAt  DateTime @updatedAt
  updatedBy  String?
}

// One tap of the conduct sheet: a behaviour/merit event against one student.
//
// key/label/points/tone are FROZEN COPIES of the vocabulary entry at log time,
// never a join back through ConductVocabularyConfig: relabelling "Merit" to "House
// point" tomorrow must not rewrite what a student was actually given today, and a
// deleted entry's events still have to render. Same reasoning as
// Announcement.audienceLabel and Referral.department.
//
// staffId is SET NULL, with staffName frozen beside it — the OPPOSITE of
// Announcement's cascade, deliberately: an announcement is the sender's own record
// and leaves with them, but a conduct event is part of the STUDENT's record, and a
// lecturer resigning must not erase a term of merits from the students who earned
// them. sessionId is SET NULL for the same reason pointed at registers: sessions
// are regenerated and deleted as timetables change, and the event outlives the
// class it was logged in.
model ConductEvent {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  staff     Staff?  @relation("ConductLogger", fields: [staffId], references: [id], onDelete: SetNull)
  staffId   String?
  staffName String

  key    String
  label  String
  points Int
  tone   String // "positive" | "negative"

  note String @default("")

  session   HndSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId String?

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([staffId])
}

// A ledger of one-off automated emails already sent, used purely to de-duplicate the
// scheduled notifications (birthdays, bank-holiday closures, assessment-deadline reminders)
// so a re-tick or a restart can never send the same one twice. `key` is a stable string,
// e.g. "birthday:student:<id>:2026", "bankholiday:2026-12-25", "assessment:<id>".
model SentNotification {
  /// `@id` on its own, and correct again.
  ///
  /// Keys like "bankholiday:2026-12-25" are identical across institutions, so when
  /// one database served several, the second college's markSent collided on the
  /// primary key — and that collision was deliberately swallowed, silently losing
  /// that college's de-duplication and letting the same notification go out twice.
  /// The key became [tenantId, key] to fix it.
  ///
  /// With one college per deployment the invariant is simply that a key is unique
  /// across everything this deployment sends, which is what the bare @id says.
  key    String   @id
  sentAt DateTime @default(now())
}

// Student Loans Company (SLC) tracking — one row per student's loan application, with its
// current status. Standalone (all fields on the row) so it can be recorded whether or not
// the person exists as an Admission/Student yet; `admissionId` optionally links to an
// applicant so the list can be pre-filled from admissions who chose Student Loans funding.
model SlcApplication {
  id                String    @id @default(cuid())
  admissionId       String? // optional link to an Admission (applicant), for convenience
  /// The enrolled student this finance record belongs to, once somebody has asserted
  /// that they are the same person.
  ///
  /// NULLABLE, permanently. An SLC record legitimately exists for someone who is not a
  /// student yet — applying for a loan is something you do BEFORE you enrol, which is
  /// why admissionId above exists. A NOT NULL column would make the table unwritable
  /// for its primary use. It is also nullable for the reason everything else here is:
  /// null means "we do not know which student this is", and for most historic rows
  /// that is the honest answer. studentRef below is free text with a "" default, and a
  /// guess made from it is not knowledge.
  ///
  /// NOT UNIQUE. One student legitimately holds several rows — a tuition loan and a
  /// maintenance loan are separate applications, and a resubmission after a decline is
  /// another. A unique index would fail on correct data and push somebody into
  /// deleting a real financial record to satisfy it.
  student           Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId         String?
  /// How the link was made: "manual", "enrolment", or "backfill:<rule>". A link made by
  /// a script and a link asserted by a named human do not carry the same weight at an
  /// appeal — and this is the only thing that makes a backfill reversible. Without it,
  /// "undo the backfill" is indistinguishable from "delete everyone's links".
  studentLinkSource String?
  studentLinkedAt   DateTime?
  /// YYYY-MM-DD, the date `status` last actually CHANGED. NOT derivable from updatedAt,
  /// which moves when somebody corrects a typo in `notes` — so "days stalled awaiting
  /// evidence" computed from updatedAt is a confidently wrong number. Null on every
  /// existing row and never backfilled: it starts being true at the next real change.
  statusChangedOn   String?
  studentName       String
  studentRef        String    @default("") // college/student ID
  course            String    @default("")
  intake            String    @default("")
  status            String    @default("Not applied") // Not applied | Applied | Awaiting evidence | Approved | In payment | Paid | Declined | Cancelled
  loanType          String    @default("") // Tuition Fee Loan | Maintenance Loan | Both | Other
  crn               String    @default("") // SLC Customer Reference Number
  applicationDate   String? // YYYY-MM-DD
  decisionDate      String? // YYYY-MM-DD
  amount            String    @default("") // free text (e.g. "£9,250")
  notes             String    @default("")
  updatedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Progression risk (predictive analysis)
//
// Everything below feeds one number per student — the Progression Score — and the
// R1..R5 band it lands in. Deliberately NOT called a probability of graduating:
// nothing here has been validated against real outcomes yet, so the UI may only
// ever say "progression risk". Every component is stored, current and historic,
// precisely so a model CAN be trained against real outcomes later without anyone
// having to redesign these tables.
// ---------------------------------------------------------------------------

/// How ONE institution weights and bands the progression score.
///
/// Same shape as AttendanceBandConfig and for the same reason: the weights (20%
/// attendance, 25% average grade, and the rest), the pass threshold, the
/// recent-attendance window and the R1..R5 boundaries are one college's academic
/// policy. A college running a Student-visa cohort cares about attendance far more
/// than one running a part-time evening course, and a score built on the wrong
/// weights tells staff to intervene on the wrong students.
///
/// At most one row per institution, and no row at all until a college edits its
/// settings: "no row" means "running on the platform defaults", which live in code
/// and are merged UNDER whatever this column holds.
model PredictionModelSettings {
  id String @id @default("singleton")

  /// The whole configuration as one JSON object — weights, band boundaries, pass
  /// threshold, recent-attendance window, attendance mode, override toggles.
  ///
  /// One column rather than a row per setting, for the same reason the attendance
  /// bands are one column: the weights are only valid as a SET (they must total
  /// 100) and the bands are only valid as a SET (they must tile 0-100 with no gap).
  /// One column replaces both atomically, so a batch recalculation running during a
  /// save can never score half a cohort against weights summing to 85.
  config Json

  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Whether a student HANDED WORK IN — which nothing in this database records today.
///
/// AssessmentGrade is not that record. A grade row exists only once the work has
/// been MARKED: moodle.js skips any grade item with an empty graderaw, because an
/// unmarked item there cannot be told apart from a genuine zero. So a student who
/// submitted on time and is sitting in a marking backlog has no AssessmentGrade
/// row, exactly like a student who submitted nothing at all. Scoring submission
/// rate off grades would therefore punish a whole cohort for its lecturer being
/// behind, which is the one failure mode that would destroy staff trust in the
/// score on day one.
///
/// Hence three states and not two. Most assessments here are LTI/Turnitin grade
/// items rather than mod_assign assignments (see the header of moodle.js), and
/// mod_assign_get_submissions returns nothing for those — so for many rows the
/// honest answer is "unknown". Unknown is excluded from the submission-rate
/// denominator: it must never push a student toward risk and must never be
/// rendered as "missing". A "manual" row is what a member of staff asserted and is
/// never overwritten by a sync, matching AssessmentGrade.source.
model AssessmentSubmission {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String

  /// "submitted" | "not_submitted" | "unknown". Validated in the route layer; a
  /// string rather than a Prisma enum, matching the rest of this schema.
  status      String  @default("unknown")
  /// YYYY-MM-DD. Compared against Assessment.dueDate for the on-time rate, so it is
  /// a plain date string like every other date the academic side stores.
  submittedOn String?
  /// "moodle" (synced) or "manual" (a person said so).
  source      String  @default("moodle")

  recordedBy String?
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
}

/// The latest progression score for one student — one row, overwritten in place.
///
/// Every component that went into the score is stored beside it, not just the
/// total. Staff will not act on a number they cannot explain, and "why is this
/// student R4?" has to be answerable from the row itself, without re-running the
/// engine against data that has since moved on.
model StudentPredictionCurrent {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// One row per student, replaced on each recalculation.
  studentId String  @unique

  /// WHAT THIS SCORE COVERS.
  ///
  /// Scoped to the student's CURRENT TERM, not their whole course. A student who
  /// struggled in Year 1 and has since recovered must not carry that forever, and — the
  /// more dangerous direction — a strong first year must not mask a collapse happening
  /// now. Grade TREND is the one deliberate exception and looks across term boundaries,
  /// because a trend that resets every September cannot see the September collapse.
  ///
  /// Stored rather than inferred: terms roll over, and a history row has to still mean
  /// what it meant on the day it was written.
  ///
  /// A null scopeTermId means no Term row covered the calculation date and a documented
  /// fallback was used instead. scopeLabel always says which, so the interface can show
  /// "Year 1 · Term 2" or "all units — no terms configured" rather than an unexplained
  /// number.
  scopeTermId String?
  scopeLabel  String  @default("")
  scopeFrom   String? // YYYY-MM-DD, inclusive
  scopeTo     String? // YYYY-MM-DD, inclusive

  // --- Components, all 0-100 unless noted ---
  overallAttendance      Float?
  /// Rolling window, 28 days by default and configurable per college.
  recentAttendance       Float?
  /// submitted / due, counting ONLY assessments whose dueDate has passed. An
  /// assessment due next month must never reduce a student's score.
  submissionRate         Float?
  onTimeRate             Float?
  /// dueDate passed AND no valid submission. Drives OVR-001 and a red indicator,
  /// so it is a count rather than a rate.
  missingAssessmentCount Int
  /// marks / maxMarks * 100, averaged. Normalised because assessments here are
  /// marked out of anything from 20 to 100.
  averageGrade           Float?

  /// "IMPROVING" | "STABLE" | "DECLINING" | "INSUFFICIENT_DATA". The sentinel is
  /// the point: fewer than four valid grades is not the same thing as a flat trend,
  /// and keeping it as a stored string keeps the two distinguishable in history
  /// forever rather than only while the engine remembers to say so.
  gradeTrend      String
  /// Float rather than Int, even though today's values are 100/70/30, because these
  /// are inputs to a weighted sum a college can retune — awarding 72.5 for a stable
  /// trend should be a settings edit and not a migration.
  gradeTrendScore Float?

  /// "IMPROVED" | "STABLE" | "DETERIORATED" | "NONE" — NONE meaning no intervention
  /// has been reviewed yet, which scores neutral rather than badly.
  interventionResponse      String
  interventionResponseScore Float?

  /// The weighted sum BEFORE the override engine runs, kept next to the final
  /// figure so "the maths said R2 and a rule pulled it to R3" is visible instead of
  /// being something a reader has to reconstruct from the codes.
  baseProgressionScore Float
  progressionScore     Float
  baseRiskLevel        String
  riskLevel            String

  /// "IMPROVING" | "STABLE" | "DECLINING" | "INSUFFICIENT_DATA" — this score minus
  /// the score 28 days ago, read out of StudentPredictionHistory.
  directionOfTravel String

  redIndicatorCount   Int     @default(0)
  overrideApplied     Boolean @default(false)
  /// JSON arrays of STRUCTURED CODES ("OVR-001", "LOW_SUBMISSION_RATE"), never
  /// display text. The text is generated from the code at render time, so rewording
  /// a driver does not orphan every row already written, and a future model can
  /// count codes without parsing English.
  overrideCodes       Json
  riskDriverCodes     Json
  positiveDriverCodes Json

  /// --- Tripwires -----------------------------------------------------------
  /// Conditions that ride ALONGSIDE the score and never inside it. None of these
  /// can move a progression score or a band; they exist so a member of staff can
  /// see a fact the weighted mean structurally cannot express.
  ///
  /// DATES, NOT DAY-COUNTS. Nothing in this feature runs on a schedule — a score
  /// exists once somebody presses Recalculate, and markStale fires on data events.
  /// A day passing is not an event, so a stored "days since last attended" would be
  /// wrong by the next morning with nothing to correct it. The date is true forever
  /// and the screen derives the age from it.
  ///
  /// All nullable, because every one of them is unmeasurable for a real student: a
  /// register nobody has taken gives no streak, and a zero would read as "we checked
  /// and they are fine".
  /// Consecutive unexplained absences at the end of the record. Excused absence
  /// breaks the run — the student told somebody, so contact was not lost.
  absenceStreak               Int?
  /// The last date the student was marked present or late. Null if never.
  lastAttendedOn              String?
  /// The oldest piece of work past its deadline carrying no answer either way.
  /// Distinct from missingAssessmentCount, which counts positive "not submitted".
  oldestUnmarkedDueDate       String?
  /// Percentage-point change between the rolling attendance window and the equal
  /// window before it. Null when either window had too little in it to compare.
  attendanceSlope             Float?
  /// The most recent date this student did ANYTHING the college can see — attended,
  /// had work marked, or spoke to somebody. Attendance alone is not engagement: a
  /// student who is not in class but is submitting work is engaged, and a sponsoring
  /// provider must now evidence academic engagement rather than attendance.
  lastEngagedOn               String?
  /// Share of this student's absence that carries no explanation, 0-100. Null when
  /// they have no absences at all — there is nothing to characterise, and 0 would
  /// read as "all authorised", a claim about absences that do not exist.
  unexplainedShare            Float?
  /// How often the student arrives late, 0-100. Null when the COLLEGE does not record
  /// lateness at all, because a rate of 0 there means "not recorded", not "never late".
  latenessRate                Float?
  /// Marks below the college's pass threshold, and marks that only just cleared it.
  /// Null when nothing has been marked — which is not a clean record.
  failCount                   Int?
  nearFailCount               Int?
  /// Spread of this student's marks. Distinguishes a steady 60 from a 95 and a 25,
  /// which the average grade reports identically. Null below two marks.
  gradeVolatility             Float?
  /// Which unit this student attends least, and how far it sits below their best.
  /// The overall percentage is the number that HIDES a quietly abandoned unit; this
  /// is the pair that finds it and names it.
  worstUnitId                 String?
  unitAttendanceSpread        Float?
  /// Units with marked work, none of which reached the pass mark. Null when nothing
  /// has been marked anywhere — a unit nobody has marked is unmeasurable, not failed.
  unpassedUnitCount           Int?
  /// Week-to-week spread of attendance. Distinguishes steady attendance from full
  /// weeks alternating with empty ones at the same overall figure. Null below three
  /// weeks of register.
  attendanceRegularity        Float?
  /// Share of MARKED work that arrived after its deadline, and by how many days on
  /// average. Read from AssessmentGrade.submittedAt rather than AssessmentSubmission,
  /// which nothing writes. Day resolution only — the Moodle importer truncates the
  /// timestamp at the boundary. Null when the feed carries no submission dates at all,
  /// because "0% late" would then describe the integration rather than the student.
  lateSubmissionRate          Float?
  meanDaysLate                Float?
  /// Weeks since the cohort started. Used mainly to SUPPRESS: inside the settling-in
  /// period a new student has no history for the disengagement codes to read, and
  /// firing them would put a whole intake on the caseload at once. Null when the
  /// cohort has neither a start date nor terms — and null is deliberately NOT treated
  /// as "brand new", which would mute every code for anybody the calendar cannot place.
  weeksIntoProgramme          Int?
  /// Work falling due in the near term. A fact about the timetable rather than the
  /// student, so it is reported and never raises a code on its own.
  assessmentsDueSoon          Int?
  /// How many marked pieces of work carried BOTH a submission date and a deadline —
  /// the denominator behind lateSubmissionRate. Stored so a percentage on the screen
  /// can be checked against the sample it came from: Moodle reports no submission date
  /// for anything that is not submission-based, so quizzes and offline marks never
  /// reach it, and "60% late" over three pieces is a different claim from over thirty.
  gradedWithDates             Int?
  /// The oldest question this student asked that nobody has answered, and how many
  /// are open. A DATE, so the screen derives the wait. NULL is not zero: 0 means the
  /// college answered everything they asked, null means they asked nothing — or the
  /// college does not answer through the system at all, in which case every query it
  /// has ever received sits at open for ever and a count would report the workflow.
  oldestOpenQueryOn           String?
  openQueryCount              Int?
  /// Follow-ups this college promised, past their date by more than the grace period,
  /// with nothing recording that they happened.
  ///
  /// NULL IS NOT ZERO AND THE DIFFERENCE IS THE WHOLE SIGNAL. Until this college has
  /// recorded a completed follow-up ANYWHERE, nothing distinguishes "promised and not
  /// done" from "promised, done, and never written down" — which is what every row
  /// written before followUpCompletedOn existed looks like. A zero would report the
  /// migration; a null reports that we cannot yet tell.
  overdueFollowUpCount        Int?
  /// The average grade WEIGHTED by what each assessment is worth, and whether it
  /// actually was. Assessment.weight is stored, validated and displayed, and the engine
  /// has never read it — so a 20% quiz and a 60% project count the same in averageGrade
  /// above. The Moodle importer never sets weight, so at a synced college every
  /// assessment carries 0 and this falls back to the plain mean: `gradeWasWeighted`
  /// records which figure you are looking at, because a number that appears to honour
  /// the weighting and silently does not is the failure this schema is organised
  /// against.
  weightedAverageGrade        Float?
  gradeWasWeighted            Boolean?
  /// Mean days between work arriving and being marked. A STAFF signal reported beside
  /// the score rather than inside it — a lecturer's backlog is not a fact about the
  /// student sitting under it, though it does mean their average rests on less work
  /// than it appears to. Null when nothing could be timed; zero would read as "marked
  /// the same day", which is praise for a college that recorded no dates.
  markingLatencyDays          Float?
  /// Absence in the first session of a teaching day against absence in the rest of it.
  /// Separates "cannot get here" — transport, caring, a night shift — from "not
  /// engaged", which need opposite conversations and produce the same overall
  /// percentage. Null unless the student has enough days carrying more than one
  /// session: a single-register day has no later session to compare against.
  firstSessionAbsenceRate     Float?
  laterSessionAbsenceRate     Float?
  /// A claim sitting undecided, and the date the oldest was raised. A STAFF signal in the
  /// same family as markingLatencyDays: the delay is the institution's, and the student
  /// underneath it is the one being harmed by it. Reported, never scored.
  /// The DATE is stored and the day count derived at render -- nothing here runs on a
  /// schedule, so "19 days" written to a column is wrong by the next morning.
  openMitigationCount         Int?
  oldestOpenMitigationOn      String?
  /// How many assessments a claim removed from the fractions, so a reader can see that
  /// the denominator shrank. Without it a 100%% submission rate from two assessments
  /// looks identical to one from twelve.
  mitigatedAssessmentCount    Int?
  /// Whether any approved claim excused attendance. Nullable rather than defaulting
  /// false: "no claim covers attendance" and "we have not looked" are different facts.
  attendanceMitigated         Boolean?
  /// WHERE THIS STUDENT STANDS AGAINST THEIR OWN COHORT. 62% attendance is a different
  /// situation at a cohort mean of 58 than at 91, and absolute thresholds cannot tell the
  /// two apart. Context reported BESIDE the score, never replacing it: a student at the
  /// 90th percentile of a failing cohort is still failing.
  /// Null below the cohort floor -- a percentile from three peers is noise, and from one
  /// it is meaningless. cohortSize is stored so a reader can see what the rank rests on;
  /// a value exactly equal to the chunk size is the fingerprint of the population having
  /// been built from the chunk, which is the recurring bug in this area.
  cohortAttendancePercentile  Float?
  cohortAttainmentPercentile  Float?
  cohortSize                  Int?
  /// The COHORT's own mean below the college's absolute threshold: the programme is in
  /// trouble and this student's ordinary standing inside it is not reassurance. A FIGURE
  /// and never a driver code, because it is true of every student at once and
  /// riskDriverCodes is a per-student caseload array.
  cohortStruggling            Boolean?
  /// HOW MUCH OF THIS STUDENT'S TIMETABLE WAS ACTUALLY REGISTERED. Three marked sessions
  /// and sixty read the same in an attendance column, and three-of-sixty-timetabled is a
  /// fact about a tutor not taking registers rather than about the student.
  /// Null when the college does not timetable at all: no scheduled sessions is unknown
  /// coverage, not zero coverage.
  registerCoverageRate        Float?
  scheduledSessionCount       Int?
  markedSessionCount          Int?
  /// "none" | "low" | "moderate" | "high" -- how much the attendance percentage rests on.
  attendanceConfidence        String?
  attendanceObservations      Int?
  /// The most recent mark of ANY status, which is when the register was last TAKEN --
  /// deliberately not lastAttendedOn, which counts only P and L. A date, so the day count
  /// is derived at render: nothing here runs on a schedule and a day passing is not an
  /// event.
  lastRegisterMarkOn          String?
  /// VLE ENGAGEMENT. Attendance says whether a student came to the room; this says
  /// whether they opened the course at all. A sponsoring provider now has to evidence
  /// academic ENGAGEMENT rather than attendance, and a student who is not in class but is
  /// working online is a different case from one who has vanished.
  /// All null where the college was never observable -- a Moodle hiding lastaccess, or one
  /// nobody uses. Zero would say "we looked at the whole college and found nothing", which
  /// is the opposite of "we could not look".
  vleLastAccessOn             String?
  vleActiveDayRate            Float?
  vleObservedDays             Int?
  vleUnitsObserved            Int?
  /// WORKLOAD. assessmentsDueSoon already counts deadlines in the next fortnight and is
  /// deliberately a figure, because a busy calendar is shared by the whole cohort. These
  /// say WHERE the work bunches, so that the busy window can be crossed with something
  /// about THIS student -- an existing backlog, or an absence in the run-up. That
  /// conjunction is the only thing here that becomes a code.
  /// Dates, never day counts: nothing runs on a schedule, so "peak in 9 days" is wrong by
  /// the next morning while the date is true for ever.
  peakFrom                    String?
  peakTo                      String?
  peakCount                   Int?
  /// The share of the peak by assessment weight, and whether the weighting was real.
  /// Assessment.weight defaults to 0 and the Moodle importer never sets it, so at a
  /// synced college the share means nothing -- gradeWasWeighted's contract, for the same
  /// reason it exists there.
  peakWeightShare             Float?
  peakWasWeighted             Boolean?
  /// How much of the horizon could not be placed on a calendar, so a reader can see that
  /// the peak is a lower bound rather than a measurement.
  undatedAssessments          Int?
  /// The union of work positively not handed in and work past due with no answer either
  /// way. Deliberately a union of two separately stored sets, so it cannot be
  /// reconstructed from either column alone.
  carriedBacklogCount         Int?
  /// FUNDING. A student whose loan has not come through is at real risk of withdrawing,
  /// and it is one of the few risks a college can act on -- hardship funds, payment
  /// plans, chasing evidence. It is also the least visible in academic data: they attend
  /// and submit right up to the day they leave.
  /// ALL NULL where the college has no linked SlcApplication rows at all. No row means
  /// "we do not know", never "no funding" -- self-funded, employer-sponsored and
  /// international students legitimately have none, and putting them on a risk register
  /// for a loan they never wanted is the failure this guards against.
  fundingPosition             String?
  /// Dates, never day counts, same rule as above.
  fundingUnsettledSince       String?
  fundingSettledOn            String?
  fundingRefusedOn            String?
  fundingApplications         Int?
  /// Recorded as "has not applied" -- a FIGURE and never a code. The string is the
  /// column default AND what routes/slc.js silently rewrites an unrecognised status to,
  /// so it means three different things, one of which is a bug.
  fundingNotApplied           Int?
  /// THE SHAPE OF THE ABSENCE, not the amount of it. A student who misses every Friday
  /// is a different conversation from one absent at random to the same percentage — the
  /// first is usually a clash, a shift or a caring commitment, and it is fixable.
  /// ISO-8601 weekday, 1 = Monday. Figures only, and deliberately: within one student's
  /// marks nothing separates "this student misses Fridays" from "nobody attends the
  /// Friday nine o'clock", and the half that would separate them is the cohort's Friday.
  worstAbsenceWeekday         Int?
  worstWeekdayAbsenceRate     Float?
  weekdayAbsenceGap           Float?
  weekdaysMeasured            Int?
  /// The same question by session KIND, where a college records one. HndSession.kind
  /// defaults to "" and is empty on every row in both databases today, so these stay null
  /// — which is the institution guard working, not a fault.
  worstAbsenceKind            String?
  worstKindAbsenceRate        Float?
  kindAbsenceGap              Float?
  kindsMeasured               Int?
  /// Whole WEEKS in which the register ran and this student appeared in none of them.
  /// Deliberately not absenceStreak, which counts consecutive absent ROWS: a partial week
  /// breaks this and not a streak, and a week with no sessions timetabled produces no
  /// marks and breaks neither. Deliberately not TRIP_NOT_SEEN either, which reads the
  /// calendar and would fire college-wide every summer — this cannot fire on a closed
  /// college at all, because a closed college produces no marks to observe.
  unseenWeekRun               Int?
  unseenSinceWeekOn           String?
  lastAttendedWeekOn          String?
  longestUnseenWeekRun        Int?
  observedWeeks               Int?
  /// WHAT THE STUDENT TOLD US BEFORE THEY STARTED. The pre-entry self-assessment is the
  /// only evidence that exists in week one, when attendance, marks and pastoral contact
  /// all have nothing in them — and every barrier it names is actionable: no wifi at
  /// home, no office software, a reservation recorded at interview.
  /// `entryProfileRecorded` is TRI-STATE. Null means the college has no linked ISM data
  /// at all; false means it does and this student has none; true means a row. The middle
  /// state is the finding — a student nobody interviewed at a college that interviews.
  entryProfileRecorded        Boolean?
  entryProfileOn              String?
  entryProfileAnswered        Int?
  entryProfileQuestions       Int?
  entryProfileBarriers        Int?
  entryWifiAtHome             Boolean?
  entryKnowsOfficeSoftware    Boolean?
  entryAdmittedOutcome        String?
  /// The date a student's right to study runs out. Stored for ever even when the
  /// caseload code has aged out, because a compliance list needs every expiry and a
  /// caseload needs only the ones worth acting on this term.
  rightToStudyExpiresOn       String?
  /// WHAT THE RISK HAS DONE, as opposed to what it is. A student stuck at the same band
  /// all year and one who fell there last week sort identically without these: the first
  /// has had an intervention that did not work, the second has had nothing tried.
  /// Dates, never day counts — nothing here runs on a schedule.
  currentBandSince            String?
  worstBandHeld               String?
  worstBandSince              String?
  observedDays                Int?
  bandChanges                 Int?
  bandsVisited                Int?
  /// Evidence about the college's own interventions on THIS student: somebody who has
  /// fallen and come back is somebody it has already helped successfully. Measured on the
  /// score rather than the band, so a climb inside one band still counts.
  recoveredPoints             Float?
  recoveredBy                 String?
  lowestScore                 Float?
  lowestOn                    String?
  /// WHEN THE SIGNALS DISAGREE. A weighted mean is exactly the operation that destroys
  /// disagreement: 95% attendance with 20% submission and 55% on both land close
  /// together, and they need opposite conversations. At most one shape is named.
  divergenceShape             String?
  attendanceSubmissionGap     Float?
  attendanceVleGap            Float?
  /// DOES THIS STUDENT FAIL A PARTICULAR KIND OF ASSESSMENT? Assessment.type has existed
  /// since the table did and nothing in the prediction layer ever read it, so a student
  /// who passes every essay and fails every exam showed an unremarkable average — the
  /// average being exactly the operation that hides it. Exam technique, timed-conditions
  /// practice and access arrangements are different purchases from essay support.
  /// `assessmentTypesMeasured` is the sharp one: null means the college records no types
  /// at all, 0 means it does and nothing cleared the sample floor.
  worstAssessmentType         String?
  worstAssessmentTypePassRate Float?
  worstAssessmentTypeMeanPct  Float?
  assessmentTypePassRateGap   Float?
  assessmentTypeMeanGap       Float?
  assessmentTypesMeasured     Int?
  assessmentTypesSeen         Int?
  untypedGradeCount           Int?
  /// IS THE SHAPE OF THE TEACHING DAY THE REASON THEY ARE NOT THERE? An early start, a
  /// six-hour day, a two-hour hole in the middle — each has a cheap concrete fix that no
  /// other figure here can point at. FIGURES ONLY, no codes: a start time is the most
  /// cohort-wide fact a college has, so a badly-timetabled unit produces the identical
  /// finding for its whole cohort at once.
  earlyStartAbsenceRate       Float?
  laterStartAbsenceRate       Float?
  earlyStartAbsenceGap        Float?
  /// Lateness as well as absence, because at a 09:00 start arriving at 09:20 is the same
  /// phenomenon as not arriving — and L counts as attendance, so a module measuring only
  /// absence would be blind to the commonest form of what this exists to find.
  earlyStartLatenessRate      Float?
  laterStartLatenessRate      Float?
  earlyStartLatenessGap       Float?
  earlyStartDays              Int?
  /// Measured per DAY, not per mark. A long day holds three or four registers, so going
  /// home at lunch scores 50% while missing a one-session short day scores 100% — which
  /// would make long days look BETTER for exactly the partial attendance they cause.
  longDayMissedRate           Float?
  shortDayMissedRate          Float?
  longDayMissedGap            Float?
  longDaysMeasured            Int?
  /// The sessions a student had to come BACK for, split by the idle gap before them.
  /// laterSessionAbsenceRate is arithmetically a weighted mean of these two, which is
  /// why it cannot see the effect.
  afterLongGapAbsenceRate     Float?
  afterShortGapAbsenceRate    Float?
  longGapAbsenceGap           Float?
  longGapSessions             Int?
  /// How much of the timetable could not be measured, so a reader can tell a null apart
  /// from a finding.
  daysWithoutSessionEnd       Int?
  singleSessionDays           Int?
  /// HOW THEY STARTED. The best-evidenced family in the progression literature: attendance
  /// in the opening weeks predicts withdrawal better than almost anything measured later.
  /// Nothing else here captures it — every other attendance figure is lifetime-to-date or
  /// a rolling recent window, and both wash out the start.
  /// UNLIKE EVERY OTHER FIGURE IN THIS TABLE, these stop moving. A student's week 1-4
  /// attendance is the same number in June as it was in October, because the window is
  /// date-bounded. If one drifts, something is wrong.
  earlyAttendance             Float?
  earlyAttendanceMarked       Int?
  subsequentAttendance        Float?
  subsequentAttendanceMarked  Int?
  earlyAttendanceGap          Float?
  earlyWindowEndsOn           String?
  /// Marks dated BEFORE the programme started. Not folded into either side: they are
  /// usually a cohort start date that is wrong, and silently counting them as "early"
  /// would hide the data-quality problem inside a student's figure.
  preStartMarked              Int?
  /// The first marked piece, against everything after it. A distinct early predictor from
  /// the average, which by construction contains it.
  firstAssessmentPct          Float?
  firstAssessmentOn           String?
  subsequentAverageGrade      Float?
  subsequentGradeCount        Int?
  firstAssessmentGap          Float?
  undatedGradeCount           Int?
  /// The single worst driver, for the one-line summary in a list view.
  primaryRiskDriver           String?

  interventionRequired  Boolean @default(false)
  /// The open Intervention this student's flag currently refers to. Deliberately a
  /// plain id and not a foreign key: this row is rewritten on every recalculation
  /// while the intervention it points at outlives several of those, so a constraint
  /// here would only ever turn a stale pointer into a failed batch run.
  currentInterventionId String?

  /// Which version of the engine produced these numbers. Two rows scored by
  /// different versions are not comparable, and without this nobody can tell which
  /// is which after a weighting change ships.
  modelVersion   String
  lastCalculated DateTime

  /// Recalculation is BATCHED, not synchronous — taking a register must not wait on
  /// a cohort's worth of scoring. Anything that invalidates a student's score sets
  /// this flag and returns; the batch picks up whatever is flagged. New rows default
  /// to stale so a student created between runs is scored at the next one.
  stale Boolean @default(true)

  @@index([stale])
  @@index([riskLevel])
}

/// Every score ever calculated for a student. APPEND ONLY.
///
/// Rows here are NEVER updated and NEVER deleted. Two things depend on that:
/// direction of travel is literally "this score minus the row nearest 28 days ago",
/// so editing history rewrites the past; and the reason every component is stored
/// rather than just the total is that a model trained on real progression outcomes
/// will train on these rows. Trimming them starts that clock again from zero.
///
/// The single exception is the student themselves being erased, which cascades — a
/// GDPR erasure that left a full behavioural profile behind would not be one.
model StudentPredictionHistory {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  calculationDateTime DateTime @default(now())

  /// WHAT THIS SCORE COVERS.
  ///
  /// Scoped to the student's CURRENT TERM, not their whole course. A student who
  /// struggled in Year 1 and has since recovered must not carry that forever, and — the
  /// more dangerous direction — a strong first year must not mask a collapse happening
  /// now. Grade TREND is the one deliberate exception and looks across term boundaries,
  /// because a trend that resets every September cannot see the September collapse.
  ///
  /// Stored rather than inferred: terms roll over, and a history row has to still mean
  /// what it meant on the day it was written.
  ///
  /// A null scopeTermId means no Term row covered the calculation date and a documented
  /// fallback was used instead. scopeLabel always says which, so the interface can show
  /// "Year 1 · Term 2" or "all units — no terms configured" rather than an unexplained
  /// number.
  scopeTermId String?
  scopeLabel  String  @default("")
  scopeFrom   String? // YYYY-MM-DD, inclusive
  scopeTo     String? // YYYY-MM-DD, inclusive

  // The same components as StudentPredictionCurrent, frozen at the moment of scoring.
  overallAttendance      Float?
  recentAttendance       Float?
  submissionRate         Float?
  onTimeRate             Float?
  missingAssessmentCount Int
  averageGrade           Float?

  gradeTrend      String
  gradeTrendScore Float?

  interventionResponse      String
  interventionResponseScore Float?

  baseProgressionScore Float
  progressionScore     Float
  baseRiskLevel        String
  riskLevel            String

  directionOfTravel String

  redIndicatorCount   Int     @default(0)
  overrideApplied     Boolean @default(false)
  overrideCodes       Json
  riskDriverCodes     Json
  positiveDriverCodes Json

  /// --- Tripwires -----------------------------------------------------------
  /// Conditions that ride ALONGSIDE the score and never inside it. None of these
  /// can move a progression score or a band; they exist so a member of staff can
  /// see a fact the weighted mean structurally cannot express.
  ///
  /// DATES, NOT DAY-COUNTS. Nothing in this feature runs on a schedule — a score
  /// exists once somebody presses Recalculate, and markStale fires on data events.
  /// A day passing is not an event, so a stored "days since last attended" would be
  /// wrong by the next morning with nothing to correct it. The date is true forever
  /// and the screen derives the age from it.
  ///
  /// All nullable, because every one of them is unmeasurable for a real student: a
  /// register nobody has taken gives no streak, and a zero would read as "we checked
  /// and they are fine".
  /// Consecutive unexplained absences at the end of the record. Excused absence
  /// breaks the run — the student told somebody, so contact was not lost.
  absenceStreak               Int?
  /// The last date the student was marked present or late. Null if never.
  lastAttendedOn              String?
  /// The oldest piece of work past its deadline carrying no answer either way.
  /// Distinct from missingAssessmentCount, which counts positive "not submitted".
  oldestUnmarkedDueDate       String?
  /// Percentage-point change between the rolling attendance window and the equal
  /// window before it. Null when either window had too little in it to compare.
  attendanceSlope             Float?
  /// The most recent date this student did ANYTHING the college can see — attended,
  /// had work marked, or spoke to somebody. Attendance alone is not engagement: a
  /// student who is not in class but is submitting work is engaged, and a sponsoring
  /// provider must now evidence academic engagement rather than attendance.
  lastEngagedOn               String?
  /// Share of this student's absence that carries no explanation, 0-100. Null when
  /// they have no absences at all — there is nothing to characterise, and 0 would
  /// read as "all authorised", a claim about absences that do not exist.
  unexplainedShare            Float?
  /// How often the student arrives late, 0-100. Null when the COLLEGE does not record
  /// lateness at all, because a rate of 0 there means "not recorded", not "never late".
  latenessRate                Float?
  /// Marks below the college's pass threshold, and marks that only just cleared it.
  /// Null when nothing has been marked — which is not a clean record.
  failCount                   Int?
  nearFailCount               Int?
  /// Spread of this student's marks. Distinguishes a steady 60 from a 95 and a 25,
  /// which the average grade reports identically. Null below two marks.
  gradeVolatility             Float?
  /// Which unit this student attends least, and how far it sits below their best.
  /// The overall percentage is the number that HIDES a quietly abandoned unit; this
  /// is the pair that finds it and names it.
  worstUnitId                 String?
  unitAttendanceSpread        Float?
  /// Units with marked work, none of which reached the pass mark. Null when nothing
  /// has been marked anywhere — a unit nobody has marked is unmeasurable, not failed.
  unpassedUnitCount           Int?
  /// Week-to-week spread of attendance. Distinguishes steady attendance from full
  /// weeks alternating with empty ones at the same overall figure. Null below three
  /// weeks of register.
  attendanceRegularity        Float?
  /// Share of MARKED work that arrived after its deadline, and by how many days on
  /// average. Read from AssessmentGrade.submittedAt rather than AssessmentSubmission,
  /// which nothing writes. Day resolution only — the Moodle importer truncates the
  /// timestamp at the boundary. Null when the feed carries no submission dates at all,
  /// because "0% late" would then describe the integration rather than the student.
  lateSubmissionRate          Float?
  meanDaysLate                Float?
  /// Weeks since the cohort started. Used mainly to SUPPRESS: inside the settling-in
  /// period a new student has no history for the disengagement codes to read, and
  /// firing them would put a whole intake on the caseload at once. Null when the
  /// cohort has neither a start date nor terms — and null is deliberately NOT treated
  /// as "brand new", which would mute every code for anybody the calendar cannot place.
  weeksIntoProgramme          Int?
  /// Work falling due in the near term. A fact about the timetable rather than the
  /// student, so it is reported and never raises a code on its own.
  assessmentsDueSoon          Int?
  /// How many marked pieces of work carried BOTH a submission date and a deadline —
  /// the denominator behind lateSubmissionRate. Stored so a percentage on the screen
  /// can be checked against the sample it came from: Moodle reports no submission date
  /// for anything that is not submission-based, so quizzes and offline marks never
  /// reach it, and "60% late" over three pieces is a different claim from over thirty.
  gradedWithDates             Int?
  /// The oldest question this student asked that nobody has answered, and how many
  /// are open. A DATE, so the screen derives the wait. NULL is not zero: 0 means the
  /// college answered everything they asked, null means they asked nothing — or the
  /// college does not answer through the system at all, in which case every query it
  /// has ever received sits at open for ever and a count would report the workflow.
  oldestOpenQueryOn           String?
  openQueryCount              Int?
  /// Follow-ups this college promised, past their date by more than the grace period,
  /// with nothing recording that they happened.
  ///
  /// NULL IS NOT ZERO AND THE DIFFERENCE IS THE WHOLE SIGNAL. Until this college has
  /// recorded a completed follow-up ANYWHERE, nothing distinguishes "promised and not
  /// done" from "promised, done, and never written down" — which is what every row
  /// written before followUpCompletedOn existed looks like. A zero would report the
  /// migration; a null reports that we cannot yet tell.
  overdueFollowUpCount        Int?
  /// The average grade WEIGHTED by what each assessment is worth, and whether it
  /// actually was. Assessment.weight is stored, validated and displayed, and the engine
  /// has never read it — so a 20% quiz and a 60% project count the same in averageGrade
  /// above. The Moodle importer never sets weight, so at a synced college every
  /// assessment carries 0 and this falls back to the plain mean: `gradeWasWeighted`
  /// records which figure you are looking at, because a number that appears to honour
  /// the weighting and silently does not is the failure this schema is organised
  /// against.
  weightedAverageGrade        Float?
  gradeWasWeighted            Boolean?
  /// Mean days between work arriving and being marked. A STAFF signal reported beside
  /// the score rather than inside it — a lecturer's backlog is not a fact about the
  /// student sitting under it, though it does mean their average rests on less work
  /// than it appears to. Null when nothing could be timed; zero would read as "marked
  /// the same day", which is praise for a college that recorded no dates.
  markingLatencyDays          Float?
  /// Absence in the first session of a teaching day against absence in the rest of it.
  /// Separates "cannot get here" — transport, caring, a night shift — from "not
  /// engaged", which need opposite conversations and produce the same overall
  /// percentage. Null unless the student has enough days carrying more than one
  /// session: a single-register day has no later session to compare against.
  firstSessionAbsenceRate     Float?
  laterSessionAbsenceRate     Float?
  /// A claim sitting undecided, and the date the oldest was raised. A STAFF signal in the
  /// same family as markingLatencyDays: the delay is the institution's, and the student
  /// underneath it is the one being harmed by it. Reported, never scored.
  /// The DATE is stored and the day count derived at render -- nothing here runs on a
  /// schedule, so "19 days" written to a column is wrong by the next morning.
  openMitigationCount         Int?
  oldestOpenMitigationOn      String?
  /// How many assessments a claim removed from the fractions, so a reader can see that
  /// the denominator shrank. Without it a 100%% submission rate from two assessments
  /// looks identical to one from twelve.
  mitigatedAssessmentCount    Int?
  /// Whether any approved claim excused attendance. Nullable rather than defaulting
  /// false: "no claim covers attendance" and "we have not looked" are different facts.
  attendanceMitigated         Boolean?
  /// WHERE THIS STUDENT STANDS AGAINST THEIR OWN COHORT. 62% attendance is a different
  /// situation at a cohort mean of 58 than at 91, and absolute thresholds cannot tell the
  /// two apart. Context reported BESIDE the score, never replacing it: a student at the
  /// 90th percentile of a failing cohort is still failing.
  /// Null below the cohort floor -- a percentile from three peers is noise, and from one
  /// it is meaningless. cohortSize is stored so a reader can see what the rank rests on;
  /// a value exactly equal to the chunk size is the fingerprint of the population having
  /// been built from the chunk, which is the recurring bug in this area.
  cohortAttendancePercentile  Float?
  cohortAttainmentPercentile  Float?
  cohortSize                  Int?
  /// The COHORT's own mean below the college's absolute threshold: the programme is in
  /// trouble and this student's ordinary standing inside it is not reassurance. A FIGURE
  /// and never a driver code, because it is true of every student at once and
  /// riskDriverCodes is a per-student caseload array.
  cohortStruggling            Boolean?
  /// HOW MUCH OF THIS STUDENT'S TIMETABLE WAS ACTUALLY REGISTERED. Three marked sessions
  /// and sixty read the same in an attendance column, and three-of-sixty-timetabled is a
  /// fact about a tutor not taking registers rather than about the student.
  /// Null when the college does not timetable at all: no scheduled sessions is unknown
  /// coverage, not zero coverage.
  registerCoverageRate        Float?
  scheduledSessionCount       Int?
  markedSessionCount          Int?
  /// "none" | "low" | "moderate" | "high" -- how much the attendance percentage rests on.
  attendanceConfidence        String?
  attendanceObservations      Int?
  /// The most recent mark of ANY status, which is when the register was last TAKEN --
  /// deliberately not lastAttendedOn, which counts only P and L. A date, so the day count
  /// is derived at render: nothing here runs on a schedule and a day passing is not an
  /// event.
  lastRegisterMarkOn          String?
  /// VLE ENGAGEMENT. Attendance says whether a student came to the room; this says
  /// whether they opened the course at all. A sponsoring provider now has to evidence
  /// academic ENGAGEMENT rather than attendance, and a student who is not in class but is
  /// working online is a different case from one who has vanished.
  /// All null where the college was never observable -- a Moodle hiding lastaccess, or one
  /// nobody uses. Zero would say "we looked at the whole college and found nothing", which
  /// is the opposite of "we could not look".
  vleLastAccessOn             String?
  vleActiveDayRate            Float?
  vleObservedDays             Int?
  vleUnitsObserved            Int?
  /// WORKLOAD. assessmentsDueSoon already counts deadlines in the next fortnight and is
  /// deliberately a figure, because a busy calendar is shared by the whole cohort. These
  /// say WHERE the work bunches, so that the busy window can be crossed with something
  /// about THIS student -- an existing backlog, or an absence in the run-up. That
  /// conjunction is the only thing here that becomes a code.
  /// Dates, never day counts: nothing runs on a schedule, so "peak in 9 days" is wrong by
  /// the next morning while the date is true for ever.
  peakFrom                    String?
  peakTo                      String?
  peakCount                   Int?
  /// The share of the peak by assessment weight, and whether the weighting was real.
  /// Assessment.weight defaults to 0 and the Moodle importer never sets it, so at a
  /// synced college the share means nothing -- gradeWasWeighted's contract, for the same
  /// reason it exists there.
  peakWeightShare             Float?
  peakWasWeighted             Boolean?
  /// How much of the horizon could not be placed on a calendar, so a reader can see that
  /// the peak is a lower bound rather than a measurement.
  undatedAssessments          Int?
  /// The union of work positively not handed in and work past due with no answer either
  /// way. Deliberately a union of two separately stored sets, so it cannot be
  /// reconstructed from either column alone.
  carriedBacklogCount         Int?
  /// FUNDING. A student whose loan has not come through is at real risk of withdrawing,
  /// and it is one of the few risks a college can act on -- hardship funds, payment
  /// plans, chasing evidence. It is also the least visible in academic data: they attend
  /// and submit right up to the day they leave.
  /// ALL NULL where the college has no linked SlcApplication rows at all. No row means
  /// "we do not know", never "no funding" -- self-funded, employer-sponsored and
  /// international students legitimately have none, and putting them on a risk register
  /// for a loan they never wanted is the failure this guards against.
  fundingPosition             String?
  /// Dates, never day counts, same rule as above.
  fundingUnsettledSince       String?
  fundingSettledOn            String?
  fundingRefusedOn            String?
  fundingApplications         Int?
  /// Recorded as "has not applied" -- a FIGURE and never a code. The string is the
  /// column default AND what routes/slc.js silently rewrites an unrecognised status to,
  /// so it means three different things, one of which is a bug.
  fundingNotApplied           Int?
  /// THE SHAPE OF THE ABSENCE, not the amount of it. A student who misses every Friday
  /// is a different conversation from one absent at random to the same percentage — the
  /// first is usually a clash, a shift or a caring commitment, and it is fixable.
  /// ISO-8601 weekday, 1 = Monday. Figures only, and deliberately: within one student's
  /// marks nothing separates "this student misses Fridays" from "nobody attends the
  /// Friday nine o'clock", and the half that would separate them is the cohort's Friday.
  worstAbsenceWeekday         Int?
  worstWeekdayAbsenceRate     Float?
  weekdayAbsenceGap           Float?
  weekdaysMeasured            Int?
  /// The same question by session KIND, where a college records one. HndSession.kind
  /// defaults to "" and is empty on every row in both databases today, so these stay null
  /// — which is the institution guard working, not a fault.
  worstAbsenceKind            String?
  worstKindAbsenceRate        Float?
  kindAbsenceGap              Float?
  kindsMeasured               Int?
  /// Whole WEEKS in which the register ran and this student appeared in none of them.
  /// Deliberately not absenceStreak, which counts consecutive absent ROWS: a partial week
  /// breaks this and not a streak, and a week with no sessions timetabled produces no
  /// marks and breaks neither. Deliberately not TRIP_NOT_SEEN either, which reads the
  /// calendar and would fire college-wide every summer — this cannot fire on a closed
  /// college at all, because a closed college produces no marks to observe.
  unseenWeekRun               Int?
  unseenSinceWeekOn           String?
  lastAttendedWeekOn          String?
  longestUnseenWeekRun        Int?
  observedWeeks               Int?
  /// WHAT THE STUDENT TOLD US BEFORE THEY STARTED. The pre-entry self-assessment is the
  /// only evidence that exists in week one, when attendance, marks and pastoral contact
  /// all have nothing in them — and every barrier it names is actionable: no wifi at
  /// home, no office software, a reservation recorded at interview.
  /// `entryProfileRecorded` is TRI-STATE. Null means the college has no linked ISM data
  /// at all; false means it does and this student has none; true means a row. The middle
  /// state is the finding — a student nobody interviewed at a college that interviews.
  entryProfileRecorded        Boolean?
  entryProfileOn              String?
  entryProfileAnswered        Int?
  entryProfileQuestions       Int?
  entryProfileBarriers        Int?
  entryWifiAtHome             Boolean?
  entryKnowsOfficeSoftware    Boolean?
  entryAdmittedOutcome        String?
  /// The date a student's right to study runs out. Stored for ever even when the
  /// caseload code has aged out, because a compliance list needs every expiry and a
  /// caseload needs only the ones worth acting on this term.
  rightToStudyExpiresOn       String?
  /// WHAT THE RISK HAS DONE, as opposed to what it is. A student stuck at the same band
  /// all year and one who fell there last week sort identically without these: the first
  /// has had an intervention that did not work, the second has had nothing tried.
  /// Dates, never day counts — nothing here runs on a schedule.
  currentBandSince            String?
  worstBandHeld               String?
  worstBandSince              String?
  observedDays                Int?
  bandChanges                 Int?
  bandsVisited                Int?
  /// Evidence about the college's own interventions on THIS student: somebody who has
  /// fallen and come back is somebody it has already helped successfully. Measured on the
  /// score rather than the band, so a climb inside one band still counts.
  recoveredPoints             Float?
  recoveredBy                 String?
  lowestScore                 Float?
  lowestOn                    String?
  /// WHEN THE SIGNALS DISAGREE. A weighted mean is exactly the operation that destroys
  /// disagreement: 95% attendance with 20% submission and 55% on both land close
  /// together, and they need opposite conversations. At most one shape is named.
  divergenceShape             String?
  attendanceSubmissionGap     Float?
  attendanceVleGap            Float?
  /// DOES THIS STUDENT FAIL A PARTICULAR KIND OF ASSESSMENT? Assessment.type has existed
  /// since the table did and nothing in the prediction layer ever read it, so a student
  /// who passes every essay and fails every exam showed an unremarkable average — the
  /// average being exactly the operation that hides it. Exam technique, timed-conditions
  /// practice and access arrangements are different purchases from essay support.
  /// `assessmentTypesMeasured` is the sharp one: null means the college records no types
  /// at all, 0 means it does and nothing cleared the sample floor.
  worstAssessmentType         String?
  worstAssessmentTypePassRate Float?
  worstAssessmentTypeMeanPct  Float?
  assessmentTypePassRateGap   Float?
  assessmentTypeMeanGap       Float?
  assessmentTypesMeasured     Int?
  assessmentTypesSeen         Int?
  untypedGradeCount           Int?
  /// IS THE SHAPE OF THE TEACHING DAY THE REASON THEY ARE NOT THERE? An early start, a
  /// six-hour day, a two-hour hole in the middle — each has a cheap concrete fix that no
  /// other figure here can point at. FIGURES ONLY, no codes: a start time is the most
  /// cohort-wide fact a college has, so a badly-timetabled unit produces the identical
  /// finding for its whole cohort at once.
  earlyStartAbsenceRate       Float?
  laterStartAbsenceRate       Float?
  earlyStartAbsenceGap        Float?
  /// Lateness as well as absence, because at a 09:00 start arriving at 09:20 is the same
  /// phenomenon as not arriving — and L counts as attendance, so a module measuring only
  /// absence would be blind to the commonest form of what this exists to find.
  earlyStartLatenessRate      Float?
  laterStartLatenessRate      Float?
  earlyStartLatenessGap       Float?
  earlyStartDays              Int?
  /// Measured per DAY, not per mark. A long day holds three or four registers, so going
  /// home at lunch scores 50% while missing a one-session short day scores 100% — which
  /// would make long days look BETTER for exactly the partial attendance they cause.
  longDayMissedRate           Float?
  shortDayMissedRate          Float?
  longDayMissedGap            Float?
  longDaysMeasured            Int?
  /// The sessions a student had to come BACK for, split by the idle gap before them.
  /// laterSessionAbsenceRate is arithmetically a weighted mean of these two, which is
  /// why it cannot see the effect.
  afterLongGapAbsenceRate     Float?
  afterShortGapAbsenceRate    Float?
  longGapAbsenceGap           Float?
  longGapSessions             Int?
  /// How much of the timetable could not be measured, so a reader can tell a null apart
  /// from a finding.
  daysWithoutSessionEnd       Int?
  singleSessionDays           Int?
  /// HOW THEY STARTED. The best-evidenced family in the progression literature: attendance
  /// in the opening weeks predicts withdrawal better than almost anything measured later.
  /// Nothing else here captures it — every other attendance figure is lifetime-to-date or
  /// a rolling recent window, and both wash out the start.
  /// UNLIKE EVERY OTHER FIGURE IN THIS TABLE, these stop moving. A student's week 1-4
  /// attendance is the same number in June as it was in October, because the window is
  /// date-bounded. If one drifts, something is wrong.
  earlyAttendance             Float?
  earlyAttendanceMarked       Int?
  subsequentAttendance        Float?
  subsequentAttendanceMarked  Int?
  earlyAttendanceGap          Float?
  earlyWindowEndsOn           String?
  /// Marks dated BEFORE the programme started. Not folded into either side: they are
  /// usually a cohort start date that is wrong, and silently counting them as "early"
  /// would hide the data-quality problem inside a student's figure.
  preStartMarked              Int?
  /// The first marked piece, against everything after it. A distinct early predictor from
  /// the average, which by construction contains it.
  firstAssessmentPct          Float?
  firstAssessmentOn           String?
  subsequentAverageGrade      Float?
  subsequentGradeCount        Int?
  firstAssessmentGap          Float?
  undatedGradeCount           Int?
  primaryRiskDriver           String?

  interventionRequired Boolean @default(false)

  modelVersion String

  /// The lookup is always "this student, nearest this date", so the pair is the
  /// index and studentId on its own is not.
  @@index([studentId, calculationDateTime])
}

/// Something a college DID about a student's risk, and what happened next.
///
/// The metrics are snapshotted onto the row rather than read back out of the
/// student's current figures, because the question this table answers is "were they
/// worse when we stepped in than they are now?" — which is unanswerable if the
/// numbers move underneath it. It is also what InterventionResponse scores against:
/// improvement means progression score +5, or recent attendance +10 percentage
/// points, or outstanding assessments reduced, each measured from these frozen
/// values.
model Intervention {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  interventionDate String // YYYY-MM-DD
  /// What was done — monitoring flag, staff notification, formal review,
  /// escalation. The band decides which: R1/R2 monitor only, R3 flag and notify,
  /// R4 a record with a review date, R5 urgent escalation and a priority review.
  interventionType String

  // --- The snapshot. Frozen deliberately; see the note above. ---
  riskLevelAtIntervention        String
  progressionScoreAtIntervention Float?
  attendanceAtIntervention       Float?
  recentAttendanceAtIntervention Float?
  submissionRateAtIntervention   Float?
  averageGradeAtIntervention     Float?
  missingAtIntervention          Int

  reviewDate String? // YYYY-MM-DD — when someone agreed to look again
  /// "open" | "reviewed" | "closed".
  status     String    @default("open")
  /// "improved" | "stable" | "deteriorated". Null until the review actually
  /// happens, and that null is what tells the engine "no response measured yet".
  outcome    String?
  reviewedAt DateTime?
  reviewedBy String?

  notes     String   @default("")
  createdBy String?
  createdAt DateTime @default(now())

  /// The pastoral conversation this intervention belongs to, when there was one.
  /// Optional and set-null on delete, matching StudentReview's own links:
  /// reorganising pastoral records must never destroy the record of an
  /// intervention, and an intervention raised automatically by the engine has no
  /// review behind it at all. The link exists so a student has ONE story rather
  /// than a risk score, a review and an intervention on three separate screens.
  studentReview   StudentReview? @relation(fields: [studentReviewId], references: [id], onDelete: SetNull)
  studentReviewId String?

  @@index([studentId])
  @@index([status])
  @@index([interventionDate])
  @@index([studentReviewId])
}

/// What actually happened to a student.
///
/// NOTHING ELSE IN THIS SCHEMA RECORDS THIS, and its absence is the single largest
/// gap in the predictive-analysis feature. Every weight in PredictionModelSettings is
/// currently somebody's opinion, because there is no way to check whether a student
/// the model called R5 actually withdrew. Until these rows exist and accumulate, the
/// score cannot be validated, no weight can be defended at an appeal on anything but
/// reasoning, and the supervised model the original specification promises has no
/// labels to train against.
///
/// WHY THE TYPE MATTERS AS MUCH AS THE EVENT. Voluntary withdrawal and required
/// academic withdrawal have DIFFERENT predictors in the literature — one is about
/// belonging and circumstances, the other about attainment — so a model trained on
/// the two mixed together learns neither well. A transfer to another provider is a
/// success for the student and a failure in any metric that cannot tell it from
/// dropping out. An agreed interruption is neither.
///
/// APPEND-ONLY IN SPIRIT: one row per student per outcome event, never deleted, for
/// the same reason StudentPredictionHistory is never deleted — this is the record of
/// what the college knew and when, and it is what an appeal turns on.
model StudentOutcome {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  /// "withdrawn" | "progressed" | "completed" | "interrupted" | "transferred"
  /// Validated in the route layer rather than by a Prisma enum, matching the rest of
  /// this schema.
  outcome     String
  /// For a withdrawal only: "voluntary" | "academic" | "financial" | "personal" |
  /// "visa" | "unknown". Null for every other outcome. Deliberately nullable and
  /// deliberately including "unknown" — a college that does not know why a student
  /// left should record that it does not know, not guess.
  reason      String?
  /// YYYY-MM-DD, the date the outcome took effect — NOT the date somebody typed it in.
  /// Those differ by weeks in practice, and a model trained on the typing date learns
  /// when administrators do paperwork.
  effectiveOn String
  /// Which academic stage they were at. Continuation is measured stage to stage, so
  /// "withdrew" means nothing without knowing from where.
  stage       String?
  notes       String  @default("")

  /// The score this student carried when the outcome was recorded, frozen. The live
  /// prediction moves; this must not, or the comparison the whole table exists for
  /// becomes circular.
  scoreAtOutcome     Float?
  riskLevelAtOutcome String?

  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([studentId])
  @@index([outcome])
  @@index([effectiveOn])
}

/// A claim that something happened to a student which the college has agreed to take
/// into account. Extensions, deferrals, and excused absence.
///
/// WHY THIS TABLE EXISTS. Nothing in this schema recorded that a college granted
/// somebody extra time, so the prediction layer saw only that work arrived late or had
/// not arrived. TRIP_CHRONIC_LATE is live today -- moodle.js populates submittedAt from
/// gradedatesubmitted, and metrics.js compares it against the assessment's own dueDate --
/// so the college was reporting a student as chronically late for using an accommodation
/// the college itself granted them, with nothing on the screen saying so.
///
/// THIS IS SPECIAL CATEGORY DATA AND THE SCHEMA IS SHAPED AROUND THAT.
///
/// A mitigating circumstance is very often health data: illness, mental health,
/// bereavement, pregnancy, a caring responsibility. Under UK GDPR Article 9 that is
/// special category data, and it is being collected for student support -- not for
/// building a risk score.
///
/// So the substance and the effect are SEPARATED IN THE ROW ITSELF:
///
///   - `status`, `coversFrom`, `coversTo`, `coversAttendance` and the adjustments say
///     WHAT the college decided. The prediction pipeline selects these and only these.
///   - `category` and `detail` say WHY. NOTHING in server/src/prediction/ may select
///     them, and prediction/adjustments.js is a pure function that never receives them.
///
/// The engine must know THAT a student has cover, never WHY. That line is enforced by
/// the select in metrics.js and asserted by a test; widening that select puts health
/// data into a risk score, which is a different processing purpose from the one it was
/// collected for.
///
/// The audit trail carries the fact of a decision and never the category -- the same
/// rule interactions.js already applies to pastoral notes, and for the same reason: the
/// audit log is read on Settings and Staff by admins never granted this page.
model MitigatingCircumstance {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  /// "open" | "approved" | "rejected" | "withdrawn". Validated in the route layer
  /// rather than by a Prisma enum, matching the rest of this schema.
  ///
  /// APPROVED and OPEN suppress; REJECTED and WITHDRAWN contribute nothing. The
  /// undecided case is argued at length in prediction/adjustments.js -- briefly: with a
  /// claim pending, "did this student fail to hand work in" is not a question about the
  /// student, because the answer depends on a decision the institution has not taken.
  /// Counting it against them would punish the student for the length of the college's
  /// own decision queue.
  status String @default("open")

  /// The window covered, YYYY-MM-DD, inclusive at both ends.
  ///
  /// CAPPED AT VALIDATION. An unbounded window is a permanent suppression, and a
  /// permanent suppression is indistinguishable from the student having been removed
  /// from the risk register altogether. The cap is the college's own setting so it
  /// widens it deliberately rather than by leaving a field blank.
  coversFrom String
  coversTo   String

  /// Whether this claim excuses ATTENDANCE as well as assessment deadlines.
  ///
  /// OPT-IN PER CLAIM, NEVER IMPLIED BY A CATEGORY. Suppressing attendance removes
  /// sessions from BOTH sides of the percentage, which is a far larger act than
  /// suppressing a submission count -- an extension on one deadline must not silently
  /// also excuse three weeks of absence. And even when set it never reaches
  /// lastAttendedOn, the absence streak or any pastoral code: a student on approved
  /// mitigating circumstances is one the college should be speaking to MORE, and a
  /// sponsoring provider still has to evidence engagement.
  coversAttendance Boolean @default(false)

  /// WHY -- special category data. Never selected by the prediction pipeline. Nullable
  /// because a college that has not recorded a category should say so rather than be
  /// forced into a guess, and because a claim can be actioned without one.
  category String?
  /// Free text. Same restriction, more strongly: this is where a student describes a
  /// bereavement or a diagnosis in their own words.
  detail   String  @default("")

  /// When the student raised it, NOT when an administrator typed it in. Those differ by
  /// days or weeks, and the gap between them is the college's own response time.
  raisedOn     String
  decidedOn    String?
  decidedBy    String?
  /// The reason for the decision, shown to staff. Not the student's account of events --
  /// that is `detail`.
  decisionNote String  @default("")

  createdBy String?
  createdAt DateTime @default(now())
  /// Set on every write. The watermark for "how long has this been sitting undecided"
  /// is taken from here and never from raisedOn, which is backdatable by design -- the
  /// same fault that had to be fixed on Interaction.
  updatedAt DateTime @updatedAt

  adjustments AssessmentAdjustment[]

  @@index([studentId])
  @@index([status])
  @@index([coversFrom])
}

/// What a claim actually changed for one piece of work.
///
/// A claim with NO adjustment rows is not incomplete -- it is the ordinary state at the
/// moment of approval, before anybody has sat down to set new dates, and it is precisely
/// when the student most needs the suppression. prediction/adjustments.js treats such a
/// claim as a blanket window over the work due inside it, so cover cannot be made to
/// wait on administrative work that has not happened yet.
model AssessmentAdjustment {
  id             String                 @id @default(cuid())
  circumstance   MitigatingCircumstance @relation(fields: [circumstanceId], references: [id], onDelete: Cascade)
  circumstanceId String
  assessment     Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId   String

  /// "extension" -- a new deadline, which is a deadline and not an exemption: an
  /// extension that has itself run out makes the work late again.
  /// "exclusion" -- this piece is not required of this student in this scope, and leaves
  /// BOTH sides of every fraction. Never counted as submitted, never as on time, never
  /// as missing.
  adjustmentType String
  /// Required for an extension, null for an exclusion. An "extension" moving a deadline
  /// EARLIER is refused at validation and, belt and braces, ignored by
  /// prediction/adjustments.js -- so a mistyped row can only ever be harmless.
  revisedDueDate String?

  createdBy String?
  createdAt DateTime @default(now())

  @@unique([circumstanceId, assessmentId])
  @@index([assessmentId])
}

/// One day's observation of whether a student reached a course in the VLE.
///
/// A ROW MEANS "WE LOOKED". An observed-but-inactive student gets a row saying
/// `accessed: false`. A student we could not observe gets NO ROW AT ALL. Absence is the
/// null, and that encoding is the whole design -- see server/src/vle/engagementNormalise.js
/// for the argument at length.
///
/// WHY IT CANNOT BE INFERRED FROM COUNTS LATER. Every other institution guard in this
/// codebase works by counting: zero "L" attendance marks across a whole college can only
/// mean the register has no lateness code, because a college where nobody was ever late
/// does not exist. Engagement breaks that trick. Zero engagement across a college is
/// EXACTLY what a genuinely disengaged cohort looks like, AND what a Moodle with
/// $CFG->hiddenuserfields set looks like, AND what a college that teaches face to face and
/// uses Moodle as a filing cabinet looks like. No count can separate them, so the
/// distinction has to be recorded at the moment of the pull by the code that saw the HTTP
/// response.
///
/// COSTS NO EXTRA MOODLE CALLS. core_enrol_get_enrolled_users is already issued once per
/// course by syncFromMoodle, and `lastcourseaccess` is already in the response being
/// thrown away.
///
/// observedOn is the day the observation is ABOUT, in the college's own timezone, and the
/// unique constraint means re-running a sync on the same day corrects the row rather than
/// duplicating it. Nothing here is a day count: day counts are derived at render, because
/// nothing in this feature runs on a schedule and a day passing is not an event.
model VleEngagement {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    String

  /// YYYY-MM-DD in the college's own zone -- the day this observation is about.
  observedOn   String
  /// Did they reach the course ON that day. FALSE is a real observation of inactivity and
  /// is what makes an active-days denominator possible at all; the not-observed case is
  /// the absence of the row.
  accessed     Boolean
  /// The last access the site reported, which may be long before observedOn. Null means
  /// the site reported 0 -- Moodle's "never" -- and NOT the epoch. Treating that zero as a
  /// timestamp dates the student to 1 January 1970 and sorts them to the top of every risk
  /// list in the college.
  lastAccessOn String?

  createdAt DateTime @default(now())

  @@unique([studentId, unitId, observedOn])
  @@index([studentId])
  @@index([observedOn])
}

// ============================================================================
// TIMETABLING
//
// A manually-assigned timetable, in the shape CELCAT uses: an EVENT is placed on a
// date at a time, and a room, one or more staff and one or more groups are assigned
// to it. Everything that identifies a resource is a real foreign key.
//
// WHY THIS IS NOT AN EXTENSION OF TimetableSlot OR HndSession
//
// TimetableSlot.lecturer and .room are free text. Answering "show me my timetable"
// over them means matching a person's NAME, so two lecturers sharing a surname see
// each other's classes, a lecturer entered once as "S. Raza" and once as "Syed Raza"
// sees half their week, and nothing anywhere reports that it happened. A timetable
// that is quietly wrong is worse than no timetable, because staff plan around it.
//
// HndSession was the other candidate -- one row, one truth, a register and a
// timetable that cannot disagree. It was rejected on unitId, which is NOT NULL and
// which the whole attendance pipeline assumes. Exams, workshops, study support and
// staff meetings belong to no module, so representing them there would mean making
// unitId nullable, and that migration reaches attendance, banding and prediction for
// a feature that has not shipped.
//
// The seam is planned and not yet built: HndSession will later carry a
// timetableEventId FK back to the event it came from, so that moving an event moves
// its register. Until then the two are separate records and can drift.
// ============================================================================

// A teachable space. Decomposed rather than stored as one label because the source
// system displays "101 - First floor [Great Titchfield Street]" -- name, floor and
// campus are three facts, and a room search by campus needs them apart.
// The college's campuses, as a managed list rather than free text on every room.
//
// Room.campus was a plain string, so "Ealing", "ealing" and "Ealing Campus" were three
// campuses to anything built on it — and the register dashboard filters by campus. A
// dropdown backed by rows cannot be misspelled; a text box silently splits a college's
// reporting in three and the split is invisible in the numbers afterwards.
//
// Not a JSON settings blob like the other small lists, because rooms hold a foreign key
// into it and a JSON array has nothing to point at.
model Campus {
  id        String   @id @default(cuid())
  name      String   @unique
  // Retired campuses stay, so historic rooms keep the campus they were actually on.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // WHERE THIS CAMPUS IS, for the check-in geofence. Both null until somebody records it.
  //
  // NULLABLE, AND NULL MEANS "WE HAVE NOT RECORDED IT" — never 0. The null-is-not-zero
  // convention has an unusually sharp edge here: latitude 0, longitude 0 is a real,
  // valid-looking coordinate in the Gulf of Guinea, so a default of zero would not read as
  // missing, it would read as a campus 5,000 km away that every student is refused from.
  // presence.js refuses (0, 0) explicitly for the same reason.
  //
  // A campus with no coordinates does not quietly opt out of the geofence — with the check
  // switched on, a class there is REFUSED and logged as `campus_not_located`. The
  // alternative is a boundary that silently stops applying wherever somebody forgot to set
  // it, which is worse than not having one, because the settings screen still says it is
  // enforced.
  latitude  Float?
  longitude Float?
  // Who pinned it and when. A coordinate that turns students away at the door is a
  // decision somebody made, and "it has always been like that" is not an answer when a
  // whole building's students cannot check in. Cheap to record, and the only trace there
  // would otherwise be.
  locatedAt DateTime?
  locatedBy String?

  rooms Room[]

  @@index([active])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  floor     String   @default("")
  // RETAINED, NOT DROPPED, for one release after the campus migration.
  //
  // 20260907T120000_timetabling_registers folds these strings into Campus rows and
  // fills campusId from them. This column is then the only record of what the free
  // text actually said, and dropping it in the same migration that consumes it would
  // leave nothing to check the match against — including nothing to recover from if
  // two campuses turned out to have been folded into one.
  //
  // Readers should use campusRef.name. serialize.js already prefers it and falls back
  // here, so a room the migration could not match still shows its campus.
  campus    String   @default("")
  campusRef Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  campusId  String?
  // NULLABLE ON PURPOSE. Null means "we have not recorded how many this room seats",
  // which is not the same as zero. A zero would make the room unusable by any future
  // capacity check, and would put a real room permanently out of use because nobody
  // had got round to measuring it.
  capacity  Int?
  // "Lecture", "Lab", "Studio" -- free text by design; every college has its own
  // vocabulary for its rooms, and an enum would be one college's.
  kind      String   @default("")
  // Retired rooms stay, so historic events keep the room they were actually in.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events TimetableEvent[]
  // The registers held in this room. See HndSession.roomId.
  registers HndSession[]

  // Two campuses may both have a room 101, and the reference institution has exactly
  // that. A unique on name alone would refuse the second one.
  //
  // Keyed on campusId rather than the campus string now that campuses are rows: with
  // the string, "Room 101" at "Ealing" and at "ealing" were two different rooms, so
  // the constraint that exists to prevent a duplicate room was defeated by a
  // capital letter.
  @@unique([name, campusId])
  @@index([active])
  @@index([campusId])
}

// What kind of thing an event is -- "Lecture", "Seminar", "Exam", "Tutorial".
// A table rather than the free string HndSession.kind uses, because the colour key
// colours BY category and a colour needs somewhere to live.
model EventCategory {
  id        String   @id @default(cuid())
  name      String
  colour    String   @default("#1a3a8f")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events TimetableEvent[]

  @@unique([name])
  @@index([active])
}

// One timetabled event on one date.
model TimetableEvent {
  id        String @id @default(cuid())
  // Strings, compared as strings, like every other academic date in this schema.
  date      String
  startTime String
  endTime   String
  title     String
  notes     String @default("")
  // The rescue hatch: an admin pastes the Teams join link here when automatic
  // calendar matching could not place the meeting. Carried down to this event's
  // registers on publish, where an explicit paste always beats the matcher.
  teamsJoinUrl String @default("")

  // Whether the Teams meeting automation should create (and later cancel) a calendar
  // event for this timetable event. Defaults false: see constraints.md — the switch
  // is off unless a college has turned it on, and off means no Graph calls at all.
  teamsAutoMeeting     Boolean   @default(false)
  // The Graph calendar event id the automation created, so a later run can find it
  // again to update or cancel it. Set only by the machine, on the run that created
  // the meeting — see the CohortTeam/UnitChannel comment on additive-only writes,
  // which this mirrors: the machine only ever cancels a meeting IT created, never one
  // it merely matched, and this column is how it tells the two apart.
  teamsCalendarEventId String?
  // When the meeting was last created or updated by the automation. Null means never
  // synced — distinct from teamsAutoMeeting being false, which means "don't sync",
  // so the two together answer both "should we?" and "did we, and when?".
  //
  // INFORMATIONAL ONLY — never a gate. It was briefly compared against `updatedAt`
  // to decide whether a change warranted re-PATCHing Microsoft ("has this event
  // moved since we last told Graph about it"), and that comparison was wrong: this
  // very column is written by the SAME update that would have bumped `updatedAt`
  // (an `@updatedAt` field, so Prisma stamps it on every write to the row,
  // including this one), which made "updatedAt > teamsMeetingSyncedAt" permanently
  // true from the first sync onward — every owned meeting got re-PATCHed, and every
  // attendee re-notified by Microsoft, on every single hourly tick forever.
  // teamsMeetingFingerprint below is the actual gate now; this column is kept only
  // for the UI/debugging question "when did the automation last touch this".
  teamsMeetingSyncedAt DateTime?
  // A fingerprint of the fields actually sent to Graph in createClassMeeting /
  // updateClassMeeting (subject, date, start/end time, the sorted attendee list) —
  // see teamsMeetingSyncedAt's comment above for what this replaced and why. The
  // engine PATCHes an owned meeting only when this differs from a freshly computed
  // fingerprint, and stores the new one after a successful PATCH (or the first
  // create). Null for an event with no owned meeting yet.
  teamsMeetingFingerprint String?

  // NULLABLE, and that nullability is the point of this table. An exam, a workshop,
  // a study-support session or a staff meeting belongs to no module -- which is
  // exactly what HndSession.unitId being NOT NULL cannot express.
  unit       Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId     String?
  course     Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId   String?
  // SetNull, not Cascade: deleting a room must not delete the classes that were in
  // it. The event survives with no room, which is visibly wrong on the screen and
  // therefore gets fixed -- a silently vanished lecture does not.
  room       Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId     String?
  category   EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?

  // Draft events are invisible to staff, exactly as TimetableSlot.published already
  // governs what students see.
  published Boolean @default(false)

  // WHEN this event last moved in time or space. A TIMESTAMP, deliberately, and not
  // a stored day count: "changed 3 days ago" written to a column is wrong by the
  // next morning with nothing to correct it, while the timestamp is true forever.
  // The screen subtracts. This backs "Highlight recently changed events".
  changedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff  TimetableEventStaff[]
  groups TimetableEventGroup[]
  // The registers this event built — one per group. See HndSession.
  registers HndSession[]

  // The occurrences one submission of the entry form created, so that "cancel this
  // class for the rest of term" is expressible at all. Without it a series is only
  // findable by matching on its fields, which stops working the moment one occurrence
  // is moved. NULL for an event created singly.
  seriesId String?
  // The administrator's per-series answer to "should this produce registers". A
  // column rather than an inference from unitId: a module CAN have a register, and
  // whether it SHOULD is a different question that only the college can answer —
  // a revision session on a taught module is the case that separates them.
  createRegisters Boolean @default(true)
  // NULL means never published. Deliberately distinct from published=false, which
  // after a withdrawal means "was published, is not now". Register creation triggers
  // on the transition into published, so it has to be able to tell those apart.
  publishedAt DateTime?

  // Every read of this table is a date-window read.

  /// Which academic department this belongs to — and here NULL MEANS "SHOWN TO EVERYONE",
  /// which is the opposite of the rule everywhere else in this feature.
  ///
  /// It is the one place fail-OPEN is right, and the reason is what the row IS. `courseId`
  /// is nullable because these deliberately carry sessions that are not units at all —
  /// "Academic Skills Workshop", "Study Support". Scoping them through the course would
  /// fail closed on that null and delete most of what this model exists for from every
  /// departmental tutor's timetable. A workshop is not a student record: hiding it removes
  /// a service, showing it reveals that the college runs a workshop on Tuesday.
  ///
  /// A column rather than a blanket "a null foreign key is public" rule, because a blanket
  /// rule is indistinguishable from somebody forgetting to set a value. Here the null is a
  /// decision, and academicScopeModels.js gives it its own `columnOrNull` kind.
  academicDepartment   AcademicDepartment? @relation(fields: [academicDepartmentId], references: [id], onDelete: SetNull)
  academicDepartmentId String?

  @@index([date])
  @@index([roomId])
  @@index([unitId])
  @@index([academicDepartmentId])
  @@index([seriesId])
}

// Which staff member teaches an event. Several are allowed -- a lecture with a
// demonstrator is two.
//
// THIS JOIN IS THE POINT OF THE WHOLE MODULE. It is what turns "show me my
// timetable" into a query on an id instead of a match on a name.
model TimetableEventStaff {
  id      String         @id @default(cuid())
  event   TimetableEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  staff   Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId String

  @@unique([eventId, staffId])
  @@index([staffId])
}

// Which group (intake) attends an event.
model TimetableEventGroup {
  id       String         @id @default(cuid())
  event    TimetableEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  cohort   Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  cohortId String

  @@unique([eventId, cohortId])
  @@index([cohortId])
}

// One college's timetable display defaults, and its notice banner.
//
// Same shape as attendanceBandConfig and branding: platform defaults in code, one
// JSON column per tenant merged over them, no row until somebody edits something, an
// allowlist on the way out, a short cache invalidated on save.
model TimetableSettings {
  /// A CONSTANT PRIMARY KEY, AND THAT IS THE SINGLETON GUARANTEE.
  ///
  /// This table held one row per institution, enforced by @@unique([tenantId]).
  /// That column is gone and the guarantee had to be replaced, not dropped:
  /// settings.js reads with findFirst() and writes with an upsert, and an upsert
  /// whose create block lets the id default to a cuid can run twice on an empty
  /// table and insert two rows. findFirst() would then return whichever the planner
  /// picked, and half the college's timetable settings would silently vanish.
  ///
  /// Matches TenantBranding, AttendanceBandConfig, PredictionModelSettings and
  /// AttendanceTapConfig, which carry the same constant for the same reason, and
  /// AttendanceEmailConfig, which has had it since it was written.
  id        String   @id @default("singleton")
  // Everything the college sets for everybody. Shape and allowlist live in
  // timetabling/settingsDefaults.js; nothing here validates it, deliberately, so a
  // key added tomorrow needs no migration.
  display   Json     @default("{}")
  updatedBy String   @default("")
  updatedAt DateTime @updatedAt
}

// One staff member's own overrides, merged OVER the college's.
//
// WHY THIS IS A TABLE AND NOT localStorage
//
// These staff use the web app and the phone app. A lecturer who hides the weekend
// and the 20:00 period would have done it on one device only, and the app would
// disagree with the website about their own settings. It is also how the source
// system behaves: My Settings follows the person.
model TimetableUserPref {
  id        String   @id @default(cuid())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  display   Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([staffId])
}

// ---------------------------------------------------------------------------
// SUPPORT REFERRALS — handing a student on to Wellbeing, ASK or Student Support
// ---------------------------------------------------------------------------

/// The college's own list of support departments.
///
/// Configuration, not a constant, because "Wellbeing / ASK / Student Support" is one
/// college's vocabulary and the next one merges two of them or adds Careers. Same
/// pattern as AttendanceBandConfig and PredictionModelSettings: platform defaults in
/// code, one JSON column merged over them, no row until somebody edits something.
model SupportDepartmentConfig {
  /// Constant primary key — the singleton guarantee. See TenantBranding for why
  /// find-then-create is not good enough and the save path upserts on this literal.
  id          String   @id @default("singleton")
  /// [{ key, name, active }]. Validated and allowlisted by supportDepartments.js on
  /// the way in and out; nothing here constrains it, so a field added tomorrow needs
  /// no migration.
  departments Json     @default("[]")
  updatedBy   String   @default("")
  updatedAt   DateTime @updatedAt
}

/// One student handed to one department, and what became of it.
///
/// NOT columns on Interaction, and not a reuse of Intervention. The PAT log sits
/// behind a single grant, so a wellbeing case note stored there is readable by every
/// tutor in the college; and every Intervention row carries a frozen snapshot of the
/// student's risk band, because it answers "were they worse when we stepped in?" — a
/// question a coursework referral to ASK has no business answering.
model Referral {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  /// The receiving department's KEY, as a plain string — deliberately NOT a foreign
  /// key to SupportDepartmentConfig.
  ///
  /// A college that merges two teams next year must not have its case records cascade
  /// away with the department row, and a referral to a team that no longer exists
  /// still has to render, under whatever key it was raised against. Same reasoning
  /// that keeps loggedBy a plain string on Interaction: the record outlives the
  /// organisation chart.
  department String

  /// The referrer's own words on why. Visible to BOTH sides — they wrote it.
  reason  String @default("")
  /// "routine" | "urgent".
  urgency String @default("routine")
  /// "open" | "accepted" | "closed".
  status  String @default("open")

  /// What became of it, as a CODE. Null until closed, and that null means "not closed
  /// yet" — never "no outcome". Null-is-not-zero, pointed at a workflow.
  outcome String?

  /// THE RECEIVING TEAM'S CASE NOTES. Never leaves the department.
  ///
  /// This field and outcomeDetail below are the two the referrer's serialiser must
  /// never name. A tutor learns that their referral was picked up and closed as
  /// "supported"; what the student disclosed is not theirs to read. Same line
  /// MitigatingCircumstance draws between what the college decided and why.
  notes         String @default("")
  /// Free text written at closure. Department-only, for the same reason as notes.
  outcomeDetail String @default("")

  /// Who acted, and when. Names as plain strings and dates as YYYY-MM-DD, matching
  /// Interaction: a referral must still say who closed it after that person has left,
  /// and a SetNull relation erases precisely the fact worth keeping.
  raisedBy   String?
  raisedOn   String // YYYY-MM-DD
  acceptedBy String?
  acceptedOn String?
  closedBy   String?
  closedOn   String?

  /// THE STUDENT ASKED FOR THIS THEMSELVES, rather than a tutor sending them.
  ///
  /// Stored rather than derived from `raisedBy IS NULL`, because null there already
  /// means something else — a staff referral whose author has been removed. Two
  /// different facts sharing one representation is how a self-referral would start
  /// rendering as "raised by a member of staff" the first time an account is deleted.
  ///
  /// It changes three things. The department is told the student came of their own
  /// accord, which is how you open the conversation. `/referrals/mine` cannot match it,
  /// so it never appears in some staff member's Sent-by-me. And the student is shown
  /// their OWN words back, which sReferralForStudent otherwise withholds — the reason on
  /// a staff referral is somebody else's account of them, the reason on this one is
  /// theirs.
  selfReferred Boolean @default(false)

  /// Whether the referrer chose to tell the student. Recorded rather than derived,
  /// because "did we tell them" is a question the college will be asked and the
  /// default is off — an unticked box and a box nobody was offered look identical
  /// afterwards unless one of them is written down.
  studentNotified Boolean @default(false)

  /// The PAT meeting this came out of, when there was one. Optional and SetNull on
  /// delete, mirroring Intervention.studentReviewId: reorganising pastoral records
  /// must never destroy a referral, and one raised from the student record or by the
  /// department itself has no meeting behind it at all.
  interaction   Interaction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  interactionId String?

  /// Where this case has been. One row per hand-off; the CURRENT department is the
  /// `department` column above, never the last row here — a trail read backwards to
  /// answer "whose queue is this in" is one missing row away from routing a case to a
  /// team that gave it up.
  transfers ReferralTransfer[]
  /// The conversation between the referrer and the department, kept apart from
  /// `notes` on purpose. See ReferralMessage.
  messages  ReferralMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([department, status])
  @@index([raisedBy])
}

/// One hand-off of a referral from one department to another.
///
/// WHY THE CASE NOTES ARE COPIED HERE AND CLEARED FROM THE REFERRAL.
///
/// Transferring is not re-addressing an envelope. A student disclosed something to
/// Wellbeing; moving the case to Careers must not move that disclosure with it, and
/// `Referral.notes` is read by whoever is on the CURRENT department. So the transfer
/// takes the notes with it — archived under the department that wrote them, readable
/// only by that department — and the receiving team starts from the referrer's
/// `reason`, which was always shared.
///
/// Deleting them instead was the rejected option: a wellbeing officer who transferred
/// a case by mistake would have destroyed their own record with one click, and the
/// college could no longer answer what its wellbeing team knew and when.
model ReferralTransfer {
  id         String   @id @default(cuid())
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referralId String

  /// Department KEYS, plain strings for the same reason Referral.department is one:
  /// the record has to render after the college has reorganised its desks.
  fromDepartment String
  toDepartment   String

  /// Why it was moved. SHARED — both departments and the referrer see it, so it is
  /// the wrong place for anything the receiving team should not read, and the screen
  /// says so where it is typed.
  reason String @default("")

  /// The sending department's case notes AS THEY STOOD at the hand-off. Readable only
  /// by members of fromDepartment; never by the receiving team, never by the referrer.
  notesAtTransfer String @default("")

  transferredBy String?
  transferredOn String // YYYY-MM-DD
  createdAt     DateTime @default(now())

  @@index([referralId])
  @@index([fromDepartment])
}

/// One message in the thread between the referrer and a department.
///
/// A THIRD VISIBILITY, AND IT EXISTS BECAUSE THE FIRST TWO FORCED A BAD CHOICE.
///
/// `reason` is the referrer talking, once. `notes` is the department talking to
/// itself, forever. Between them there was nowhere for "which unit is this about?" to
/// go, so it went into the case notes where the person who asked could not read the
/// answer — or out of the system into email, which is worse.
///
/// Scoped to the department it was written under, NOT to the referral. After a
/// transfer the receiving team reads its own thread and not the previous team's, which
/// is the same line ReferralTransfer draws through the case notes. The referrer reads
/// every message, because every message was written to or by them.
model ReferralMessage {
  id         String   @id @default(cuid())
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referralId String

  /// Whose side of the conversation. Stamped at write time from the referral's CURRENT
  /// department rather than from the author's membership: the referrer is not on any
  /// department, and their message still belongs to the thread the department reads.
  department String

  /// "referrer" | "department". Stored rather than derived from authorName, which is
  /// a plain string and stops matching anybody once they leave.
  authorRole String
  authorName String?
  body       String

  createdAt DateTime @default(now())

  @@index([referralId, department])
}

/// The college's own list of ACADEMIC departments — Business, Computing, Law, Health &
/// Social Care.
///
/// NOT SupportDepartmentConfig, which lists WELLBEING TEAMS. Two access boundaries with
/// one English word between them: that one decides who reads a student's disclosure,
/// this one decides which students a member of staff may see at all. See
/// academicDepartments.js, and academicDepartmentNaming.test.js, which fails if any
/// model outside the referral family grows a bare `department` field.
///
/// A REAL TABLE with real foreign keys, unlike SupportDepartmentConfig's JSON column.
/// A support department deliberately has nothing pointing at it, so a referral outlives
/// its team. Course and Student join to THIS on the hottest query path in the
/// application, and a JSON blob cannot be indexed. Deletion safety is onDelete: SetNull
/// on the referencing side instead — the choice Unit.courseId already makes so that
/// registers never vanish with a deleted course.
model AcademicDepartment {
  id     String  @id @default(cuid())
  /// Slug, [a-z0-9-]{1,40}. IMMUTABLE once created: a saved filter, a URL fragment and
  /// the VLE mapping screen all carry it, and none of them re-resolves it afterwards.
  key    String  @unique
  name   String
  colour String  @default("#1a3a8f")
  /// A retired department KEEPS its courses and students — it simply stops being offered
  /// as a destination. Deleting is the destructive option: it sets academicDepartmentId
  /// to null on every course and student pointing here, which under scoping hides a
  /// whole department's records from everyone but college-wide accounts. This is the
  /// reversible one, and the route layer offers it instead.
  active Boolean @default(true)

  createdAt DateTime @default(now())

  courses        Course[]
  students       Student[]
  staff          StaffAcademicDepartment[]
  /// The pending sign-up requests suggesting this school. NOT a membership: see
  /// SignupRequest.academicDepartmentId, which is a suggestion an admin recorded, where
  /// `staff` above is the grant itself.
  signupRequests SignupRequest[]
  TimetableSlot  TimetableSlot[]
  Cohort         Cohort[]
  Unit           Unit[]
  TimetableEvent TimetableEvent[]

  @@index([active])
}

/// Which academic departments a member of staff may see.
///
/// A JOIN TABLE, NOT A JSON ARRAY, and this is the one place the design deliberately
/// diverges from Staff.supportDepartments. That column is a JSON string array because a
/// support department has no row to point at. This one does, and the membership is a
/// SECURITY boundary: a JSON array can hold a key that was typo'd (granting nothing,
/// silently) or renamed (granting something else, silently). A foreign key cannot.
///
/// Cascades on both sides. Deleting a staff account or a department removes the
/// membership rows and nothing else — no course, student or register is reachable from
/// here, so there is nothing else for a cascade to reach.
model StaffAcademicDepartment {
  id                   String             @id @default(cuid())
  staff                Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId              String
  academicDepartment   AcademicDepartment @relation(fields: [academicDepartmentId], references: [id], onDelete: Cascade)
  academicDepartmentId String
  createdAt            DateTime           @default(now())

  @@unique([staffId, academicDepartmentId])
  @@index([academicDepartmentId])
}

// Which staff pages and student screens this college switched off, renamed or
// reordered — the eleventh table of the constant-key shape (configuration.md).
//
// ONE JSON COLUMN holding { functions, labels, order }, not a row per function, and
// not a column per surface. The three parts are only meaningful together: an `order`
// list naming a function that `functions` switched off is contradictory, and a reader
// that saw one half written and not the other would render a nav with a hole in it.
// One column means a reader sees the whole old state or the whole new one.
//
// Deliberately NOT shallow-merged on save, for the reason attendanceBandConfig states
// at length: a merge cannot express REMOVAL, and switching a function back ON is done
// by deleting its key. A merge would make "on" unreachable — the key would survive
// every later save and the screen would never come back.
//
// Defaults, validation and the allowlist live in src/appFunctionConfig.js; the registry
// of what a function IS lives in src/appFunctions.js. No row means "this college has
// never changed anything", which must behave exactly as it did before this feature
// existed — so the defaults are "everything on", in code.
model AppFunctionConfig {
  id        String   @id @default("singleton")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// A function the college ADDED from the Develop App screen, rather than one of ours it
// switched off: an external link, a page of its own words, a shortcut tile, a banner.
//
// A TABLE OF ROWS, NOT A JSON COLUMN, and that is the opposite choice from
// AppFunctionConfig above on purpose. These are a LIST that grows and shrinks, each
// entry independently editable, and the invariant AppFunctionConfig has (the three
// parts are only valid together) does not apply: adding a library link has no bearing
// on whether another link is valid. Rows also give each item a stable id, which a
// JSON array cannot — reordering an array silently renumbers every item, and a push
// notification or a deep link that named item 3 would then open item 4.
//
// `sortOrder` is NOT named `order`: that is a reserved word in SQL, and while Prisma
// quotes it, every hand-written query and migration afterwards has to remember to.
//
// `startsOn` / `endsOn` are TEXT in YYYY-MM-DD, not DateTime — dates are strings here
// and compared as strings (conventions.md), because a banner window is a calendar
// decision the college makes in its own timezone, not an instant.
//
// `content` is JSON rather than TEXT because a page body is a list of BLOCKS, never
// raw HTML: a college-authored page is rendered in both apps, and storing HTML would
// make every one of those render sites an XSS sink. See src/appCustomItems.js, which
// is the only thing allowed to decide what a block may contain.
model AppCustomItem {
  id          String   @id @default(cuid())
  // "staff" | "student" | "both" — validated in src/appCustomItems.js, not by an enum,
  // matching how every other string vocabulary in this schema is handled (Referral
  // .department, ConductEvent.tone): an enum means a migration to add a value.
  surface     String
  // "link" | "page" | "tile" | "banner"
  kind        String
  label       String
  icon        String?
  url         String?
  // "webview" | "browser" — only meaningful for link and tile.
  openIn      String?
  content     Json?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Banner window only. Null means "no bound in that direction", which is NOT the same
  // as today — an open-ended banner is the common case (null≠zero, conventions.md).
  startsOn    String?
  endsOn      String?
  dismissible Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  // The one read path is "every enabled item for this surface, in display order",
  // which filters on surface+enabled and orders by sortOrder.
  @@index([surface, enabled, sortOrder])
}
