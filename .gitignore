# dependencies
node_modules

# secrets — never commit (contains DB password, JWT secret, SMTP creds)
.env
*/.env
.env.production
*/.env.production

# app-signing keys — never commit. Leaking the upload key lets anyone publish an
# update to the real listing, and it cannot be revoked without Google's help.
# client/android/.gitignore also covers these, but only inside that folder; these
# rules apply repo-wide so a key saved anywhere is still ignored.
*.jks
*.keystore
keystore.properties

# databases & backups (data — never commit)
*.db
*.db-journal

# build output
dist

# scratch / temp scripts (migration, seeding)
server/_*.cjs
migration-data.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
**/.idea/
client.zip

# Agent worktrees — scratch clones, never part of the repo
.claude/worktrees/

# Backfill proposals are per-database and contain student identifiers — they belong
# in a scratch directory a person reads, never in version control.
student-link-proposals-*.csv

# Playwright visual-check output (see the "Visual check with Playwright" memory note) —
# screenshots and result logs of a real, running app, written to a scratch folder at
# the repo root by design so they are easy to find, but never meant to be committed.
_e2e-shots/
_e2e-*.json
_e2e-*.ndjson
