# The staging front end's API.
#
# Only read by `npm run build:staging` (vite build --mode staging). A plain
# `npm run build` is production mode and uses .env.production, so this file has no
# effect unless that script is what Vercel runs — see the note in .env.production.
#
# edtech-staging-api deploys automatically from `main` and runs `migrate:deploy` in its
# build, so this is the API that has the newest schema. It is the right target for
# checking a feature before production sees it.
VITE_API_URL="https://edtech-staging-api.onrender.com/api"
