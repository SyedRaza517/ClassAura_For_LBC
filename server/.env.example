# Copy this file to .env and adjust as needed.

# ---------------------------------------------------------------------------
# Database. PostgreSQL only — schema.prisma declares provider = "postgresql",
# so the old "file:./dev.db" SQLite URL this file used to ship could never work
# against it. There is no local database file any more.
#
# The value below is a LOCAL Postgres. Point it at a database you own and can
# afford to lose: `npm run setup` and `npm run seed` DELETE staff, students,
# check-ins, leave and documents before writing their fixtures.
#
# prisma/assertDisposable.js refuses to seed a remote database unless its name
# marks it disposable (…_staging, …_test) or you confirm it explicitly. That is a
# backstop, not permission to point this at something live.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edtech_dev"

# Must be a long random string. In production the server REFUSES to start without
# one rather than falling back to a known default.
JWT_SECRET="change-this-to-a-long-random-string"
# How long a session lasts: "8h", "1d", "7d".
JWT_EXPIRES="1d"
PORT=4000

# ---------------------------------------------------------------------------
# This deployment's institution.
#
# ONE DEPLOYMENT SERVES ONE COLLEGE, with its own database. There is no X-Tenant
# header, no subdomain resolution and no "which college is this request for?"
# question — every request is about this institution, and the old
# DEFAULT_TENANT_SLUG, TENANT_BASE_DOMAIN and TENANT_CACHE_MS variables are gone.
# If they are still set on a deployed service, nothing reads them; see render.yaml
# for the ones that need removing by hand in the Render dashboard.
# ---------------------------------------------------------------------------
# The slug of the single institution row the seed creates or updates. It NAMES
# this deployment's institution; it does not select between several, because
# there are no others. Leave it alone unless the row already exists under a
# different slug — changing it makes the seed create a SECOND institution row
# rather than rename the first.
# SEED_TENANT_SLUG="default"
# 32-byte key (64 hex chars) encrypting this institution's stored Moodle and
# SharePoint credentials at rest — AES-256-GCM, see src/secrets.js. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, integration credentials cannot be saved or read.
# CREDENTIALS_KEY=""

# The organisation's wall clock. Drives "today", the term gate and the 02:00
# Moodle sync — not the host's timezone, which on a cloud host is usually UTC.
APP_TIMEZONE="Europe/London"
# Where the client is served. Password-reset links are built from this, so it must
# match the address people actually use, not localhost, once you deploy.
CLIENT_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Email (optional). Leave every SMTP_* line commented out and the app prints
# messages to the console instead of sending them — handy for local development,
# but password-reset links will never reach real staff.
#
# Test your settings with:  node scripts/check-email.mjs you@example.com
# ---------------------------------------------------------------------------

# Either a single connection string...
# SMTP_URL="smtp://user:password@smtp.example.com:587"

# ...or the individual settings:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587           # 587 = STARTTLS (usual), 465 = implicit TLS
# SMTP_SECURE=false       # set true only for port 465
# SMTP_USER="no-reply@edtech.co.uk"
# SMTP_PASS="app-password-here"

# The From: address staff will see.
# MAIL_FROM="EdTech Staff Hub <no-reply@edtech.co.uk>"

# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an
#   App Password (Google Account -> Security -> 2-Step Verification -> App
#   passwords). Your normal password will NOT work.
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.

# ---------------------------------------------------------------------------
# Push notifications (optional). Unset = notifications are logged to the console;
# the in-app bell and email still work. Needed for the mobile app.
#
# Set up: Firebase console -> Project settings -> Service accounts ->
#         Generate new private key. Keep that JSON OUT of the repository.
# Test with:  node scripts/check-push.mjs
# ---------------------------------------------------------------------------
# FCM_PROJECT_ID="edtech-hub"
# FCM_SERVICE_ACCOUNT="C:/secure/path/firebase-service-account.json"
# ...or paste the JSON inline instead (for hosts that only offer env vars):
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
