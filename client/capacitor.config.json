{
  "appId": "uk.co.classaura.app",
  "appName": "ClassAura",
  "webDir": "dist",
  "backgroundColor": "#ffffffff",
  "android": {
    "backgroundColor": "#ffffffff",
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#ffffffff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#ffffffff",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
